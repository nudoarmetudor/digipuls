<h1><%= t('workspace_choose_title') %></h1>
<p class="subtitle"><%= t('workspace_choose_subtitle') %></p>

<% if (hasNone) { %>
  <div class="card">
    <p><%= t('workspace_none') %></p>
  </div>
<% } else { %>
  <div class="card card-flat">
    <p class="small" style="margin:0;"><%= t('workspace_tab_note') %></p>
  </div>

  <ul class="workspace-list">
    <% options.forEach(function (o) { %>
      <li>
        <a class="workspace-card<%= o.isCurrent ? ' is-current' : '' %>" href="<%= o.href %>">
          <span class="workspace-role"><%= t('role_' + o.role) %></span>
          <span class="workspace-institution">
            <% if (o.institution) { %><%= o.institution %>
            <% } else { %><%= t('workspace_no_institution') %><% } %>
          </span>
          <% if (o.label && o.label !== t('role_' + o.role)) { %><span class="workspace-label"><%= o.label %></span><% } %>
          <span class="small"><%= t('workspace_capability_count', { n: o.capabilityCount }) %></span>
          <% if (o.isCurrent) { %>
            <span class="badge badge-draft"><%= t('workspace_current') %></span>
          <% } %>
        </a>
      </li>
    <% }) %>
  </ul>
<% } %>
