<h1><%= t('admin_add_title') %></h1>
<p class="subtitle"><%= t('admin_add_subtitle') %></p>

<div class="card">
  <h2 class="plain-heading"><%= t('admin_step1') %></h2>
  <label for="sime-search"><%= t('admin_sime_search_label') %></label>
  <input type="search" id="sime-search" placeholder="<%= t('admin_sime_search_placeholder') %>"
         aria-describedby="sime-results-status" autocomplete="off">
  <p id="sime-results-status" class="visually-hidden" role="status" aria-live="polite"></p>
  <div id="sime-results" style="margin-top:0.6rem;" aria-label="<%= t('admin_results_label') %>"></div>
</div>

<div class="card">
  <h2 class="plain-heading"><%= t('admin_step2') %></h2>
  <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
    <div class="flash flash-error" role="alert"><%= errorMessage %></div>
  <% } %>
  <form method="POST" action="<%= href('/admin/schools') %>" id="school-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="f-simeId"><%= t('sime_id') %></label>
    <input type="text" name="simeId" id="f-simeId" value="<%= (body && body.simeId) || '' %>">

    <label for="f-name"><%= t('f_name') %></label>
    <input type="text" name="name" id="f-name" required value="<%= (body && body.name) || '' %>">

    <label for="f-address"><%= t('f_address') %></label>
    <input type="text" name="address" id="f-address" value="<%= (body && body.address) || '' %>">

    <div class="inline-fields">
      <div>
        <label for="f-territoryId"><%= t('f_territory') %></label>
        <select name="territoryId" id="f-territoryId">
          <% territories.forEach(terr => { %><option value="<%= terr.id %>" <%- (body && String(body.territoryId) === String(terr.id)) ? 'selected' : '' %>><%= terr.name %></option><% }) %>
          <option value="new" <%- (body && body.territoryId === 'new') ? 'selected' : '' %>><%= t('f_new_territory_option') %></option>
        </select>
      </div>
      <div>
        <label for="f-territoryName"><%= t('f_new_territory_name') %></label>
        <input type="text" name="territoryName" id="f-territoryName" value="<%= (body && body.territoryName) || '' %>">
      </div>
    </div>

    <div class="inline-fields">
      <div>
        <label for="f-enrolmentTotal"><%= t('f_total_enrolment') %></label>
        <input type="number" name="enrolmentTotal" id="f-enrolmentTotal" min="0" step="1" required value="<%= (body && body.enrolmentTotal) || '' %>">
      </div>
      <div>
        <label for="f-studentsGrades7to12"><%= t('f_students_7_12') %></label>
        <input type="number" name="studentsGrades7to12" id="f-studentsGrades7to12" min="0" step="1" value="<%= (body && body.studentsGrades7to12) || '' %>">
      </div>
      <div>
        <label for="f-classroomsTotal"><%= t('f_total_classrooms') %></label>
        <input type="number" name="classroomsTotal" id="f-classroomsTotal" min="0" step="1" value="<%= (body && body.classroomsTotal) || '' %>">
      </div>
    </div>

    <h3 style="margin-top:1rem;"><%= t('admin_team_login_title') %></h3>
    <div class="inline-fields">
      <div>
        <label for="f-teamLogin"><%= t('f_team_login') %></label>
        <input type="text" name="teamLogin" id="f-teamLogin"
               autocapitalize="none" spellcheck="false" pattern="[A-Za-z0-9._@-]{3,64}" value="<%= (body && body.teamLogin) || '' %>">
      </div>
      <div>
        <label for="f-teamName"><%= t('f_team_name') %></label>
        <input type="text" name="teamName" id="f-teamName" value="<%= (body && body.teamName) || '' %>">
      </div>
    </div>

    <div style="margin-top:1rem;"><button class="btn" type="submit"><%= t('admin_create_school') %></button></div>
  </form>
</div>

<script nonce="<%= cspNonce %>">
/* SIME lookup. Results are rendered as real <button>s inside a <ul> so they
   can be reached by keyboard and are announced as a list of choices — the
   earlier click-only <div>s were mouse-only. Result count goes to a live
   region, because an autocomplete that only *looks* like it found something
   is useless to a screen-reader user. */
(function () {
  var searchInput = document.getElementById('sime-search');
  var resultsDiv = document.getElementById('sime-results');
  var statusEl = document.getElementById('sime-results-status');
  var noMatches = <%- JSON.stringify(t('admin_no_matches')) %>;
  // Carries the workspace prefix, same as every other link on the page.
  var searchEndpoint = <%- JSON.stringify(href('/admin/sime/search')) %>;
  var debounce;

  function fill(s) {
    document.getElementById('f-simeId').value = s.simeId || '';
    document.getElementById('f-name').value = s.name || '';
    document.getElementById('f-address').value = s.address || '';
    document.getElementById('f-enrolmentTotal').value = s.enrolmentTotal || '';
    document.getElementById('f-studentsGrades7to12').value = s.studentsGrades7to12 || '';
    document.getElementById('f-classroomsTotal').value = s.classroomsTotal || '';
    document.getElementById('f-territoryId').value = 'new';
    document.getElementById('f-territoryName').value = s.territory || '';
    document.getElementById('f-name').focus();
  }

  searchInput.addEventListener('input', function () {
    clearTimeout(debounce);
    var q = searchInput.value.trim();
    if (!q) { resultsDiv.innerHTML = ''; statusEl.textContent = ''; return; }
    debounce = setTimeout(function () {
      fetch(searchEndpoint + '?q=' + encodeURIComponent(q))
        .then(function (res) { return res.json(); })
        .then(function (data) {
          resultsDiv.innerHTML = '';
          statusEl.textContent = data.length ? String(data.length) : noMatches;
          if (!data.length) {
            var p = document.createElement('p');
            p.className = 'small';
            p.textContent = noMatches;
            resultsDiv.appendChild(p);
            return;
          }
          var ul = document.createElement('ul');
          ul.style.cssText = 'list-style:none;padding:0;margin:0;';
          data.forEach(function (s) {
            var li = document.createElement('li');
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'card card-flat';
            btn.style.cssText = 'display:block;width:100%;text-align:left;cursor:pointer;padding:0.6rem 0.9rem;margin-bottom:0.4rem;font:inherit;color:inherit;';
            var name = document.createElement('b');
            name.textContent = s.name;
            var id = document.createElement('span');
            id.className = 'small mono';
            id.textContent = ' ' + s.simeId;
            var meta = document.createElement('span');
            meta.className = 'small';
            meta.style.display = 'block';
            meta.textContent = s.address + ' · ' + s.enrolmentTotal;
            btn.append(name, id, meta);
            btn.addEventListener('click', function () { fill(s); });
            li.appendChild(btn);
            ul.appendChild(li);
          });
          resultsDiv.appendChild(ul);
        });
    }, 200);
  });
})();
</script>
