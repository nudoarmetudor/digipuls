<h1><%= t('admin_created_title') %></h1>

<div class="card card-ok">
  <p><%= t('admin_created_body', { name: school.name, band: school.enrolmentBand }) %></p>
</div>

<% if (teamAccountEmail) { %>
  <div class="card">
    <h2 class="plain-heading"><%= t('admin_temp_pw_title') %></h2>
    <p class="small text-bad" role="alert"><%= t('admin_temp_pw_warning') %></p>
    <div class="table-scroll">
      <table>
        <tbody>
          <tr><th scope="row"><%= t('th_email') %></th><td class="mono"><%= teamAccountEmail %></td></tr>
          <tr><th scope="row"><%= t('th_temp_password') %></th><td class="mono"><b><%= tempPassword %></b></td></tr>
        </tbody>
      </table>
    </div>
  </div>
<% } else { %>
  <div class="card">
    <p class="small"><%= t('admin_no_team_account') %></p>
  </div>
<% } %>

<div class="card card-centre">
  <div class="btn-row" style="justify-content:center;">
    <a class="btn" href="/ministry/schools/<%= school.id %>"><%= t('admin_go_to_record') %> <span aria-hidden="true">→</span></a>
    <a class="btn btn-secondary" href="/admin/schools/new"><%= t('admin_add_another') %></a>
  </div>
</div>
