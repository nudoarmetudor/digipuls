<h1><%= t('audit_title') %></h1>
<p class="subtitle"><%= t('audit_subtitle') %></p>
<p class="small"><%= t('audit_ip_note') %></p>

<div class="table-scroll">
  <table>
    <caption><%= t('audit_title') %> (<%= entries.length %>)</caption>
    <thead>
      <tr>
        <th scope="col"><%= t('th_when') %></th>
        <th scope="col"><%= t('th_user') %></th>
        <th scope="col"><%= t('th_action') %></th>
        <th scope="col"><%= t('th_entity') %></th>
        <th scope="col"><%= t('th_details') %></th>
        <th scope="col"><%= t('th_from') %></th>
      </tr>
    </thead>
    <tbody>
      <% entries.forEach(e => { %>
        <tr>
          <td class="small"><%= new Date(e.createdAt).toLocaleString(lang) %></td>
          <td class="small"><%= e.user ? e.user.name : '—' %></td>
          <td class="small mono"><%= e.action %></td>
          <td class="small"><%= e.entityType %> #<%= e.entityId %></td>
          <td class="small"><%= e.details || '' %></td>
          <%# Only sign-in carries one; everything else is blank on purpose. %>
          <td class="small mono"><%= e.ipAddress || '' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
