<%
/* Account details plus the list of posts the person holds.

   A person is not a role: Elena is a meta-mentor at one lyceum and the
   DigiPuls coordinator at another, from one login. So the role, the
   institution and the permissions all belong to the post, and this screen
   edits a list of them rather than a single role field. */
const isEdit = mode === 'edit';
const val = (k) => (user && user[k] !== undefined && user[k] !== null ? user[k] : '');
%>
<h1><%= isEdit ? t('admin_user_edit_title') : t('admin_user_new_title') %></h1>
<p class="subtitle"><%= t('admin_user_form_subtitle') %></p>

<% if (errorMessage) { %><div class="flash flash-error" role="alert"><%= errorMessage %></div><% } %>

<div class="card">
  <h2 class="plain-heading"><%= t('admin_user_section_account') %></h2>
  <form method="POST" action="<%= isEdit ? href('/admin/users/' + user.id) : href('/admin/users') %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="f-name"><%= t('admin_user_name') %></label>
    <input type="text" id="f-name" name="name" value="<%= val('name') %>" required autocomplete="off">

    <label for="f-login"><%= t('login_username') %></label>
    <input type="text" id="f-login" name="login" value="<%= val('login') %>" required
           autocomplete="off" autocapitalize="none" spellcheck="false"
           pattern="[A-Za-z0-9._@-]{3,64}">
    <p class="help"><%= t('admin_user_login_help') %></p>

    <% if (!isEdit) { %>
      <h3 style="margin-top:1.2rem;"><%= t('admin_user_first_post') %></h3>
      <p class="help"><%= t('admin_user_first_post_help') %></p>
      <%- include('_post-fields', {
            idPrefix: 'new',
            role: typeof firstRole !== 'undefined' && firstRole ? firstRole : 'META_MENTOR',
            schoolId: null, territoryId: null, label: '',
            selected: typeof firstSelected !== 'undefined' ? firstSelected : null,
            schools, territories, roles, capabilityGroups, roleDefaults, defaultsFor, t
          }) %>
      <p class="help"><%= t('admin_user_create_password_note') %></p>
    <% } %>

    <div class="btn-row" style="margin-top:1rem;">
      <button class="btn" type="submit"><%= isEdit ? t('admin_user_save') : t('admin_user_create') %></button>
      <a class="btn btn-secondary" href="<%= href('/admin/users') %>"><%= t('cancel') %></a>
    </div>
  </form>
</div>

<% if (isEdit) { %>
  <h2 id="posts-h"><%= t('admin_user_posts') %></h2>
  <p class="small"><%= t('admin_user_posts_help') %></p>

  <% if (posts.length === 0) { %>
    <div class="card"><p><%= t('admin_user_no_posts') %></p></div>
  <% } %>

  <% posts.forEach(function (post) { %>
    <section class="card" aria-labelledby="post-<%= post.id %>">
      <h3 id="post-<%= post.id %>">
        <%= t('role_' + post.role) %><% if (post.institution) { %> · <%= post.institution %><% } %>
        <% if (!post.isActive) { %> <span class="badge badge-maintained"><%= t('admin_user_inactive') %></span><% } %>
      </h3>

      <% if (can('admin.grant')) { %>
      <form method="POST" action="<%= href('/admin/users/' + (user.id) + '/assignments/' + (post.id)) %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="inline-fields">
          <div>
            <label for="label-<%= post.id %>"><%= t('admin_user_post_label') %></label>
            <input type="text" id="label-<%= post.id %>" name="label" value="<%= post.label || '' %>"
                   placeholder="<%= t('admin_user_post_label_placeholder') %>">
          </div>
          <div>
            <label class="checkbox" for="active-<%= post.id %>" style="margin-top:1.7rem;">
              <input type="checkbox" id="active-<%= post.id %>" name="isActive" value="true" <%= post.isActive ? 'checked' : '' %>>
              <span><%= t('admin_user_post_active') %></span>
            </label>
          </div>
        </div>

        <%- include('_capability-picker', {
              idPrefix: 'p' + post.id, role: post.role, selected: post.selected,
              capabilityGroups, roleDefaults, defaultsFor, roles, t
            }) %>

        <div class="btn-row" style="margin-top:0.8rem;">
          <button class="btn btn-sm" type="submit">
            <%= t('admin_user_save') %><span class="visually-hidden"> — <%= t('role_' + post.role) %></span>
          </button>
        </div>
      </form>

      <form method="POST" action="<%= href('/admin/users/' + (user.id) + '/assignments/' + (post.id) + '/delete') %>"
            data-confirm="<%= t('admin_user_post_remove_confirm') %>" style="margin-top:0.6rem;">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-sm btn-danger" type="submit">
          <%= t('admin_user_post_remove') %><span class="visually-hidden"> — <%= t('role_' + post.role) %></span>
        </button>
      </form>
      <% } else { %>
        <p class="small"><%= post.label ? post.label + ' · ' : '' %><%= t('admin_user_cap_count', { n: post.selected.size }) %></p>
        <p class="help"><%= t('admin_user_needs_grant') %></p>
      <% } %>
    </section>
  <% }) %>

  <% if (can('admin.grant')) { %>
  <section class="card" aria-labelledby="add-post-h">
    <h2 class="plain-heading" id="add-post-h"><%= t('admin_user_post_add') %></h2>
    <form method="POST" action="<%= href('/admin/users/' + (user.id) + '/assignments') %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <%- include('_post-fields', {
            idPrefix: 'add', role: 'META_MENTOR', schoolId: null, territoryId: null, label: '',
            selected: null, schools, territories, roles, capabilityGroups, roleDefaults, defaultsFor, t
          }) %>
      <div class="btn-row" style="margin-top:0.8rem;">
        <button class="btn" type="submit"><%= t('admin_user_post_add') %></button>
      </div>
      <p class="help"><%= t('admin_user_post_add_help') %></p>
    </form>
  </section>
  <% } %>

  <div class="card">
    <h2 class="plain-heading"><%= t('admin_user_danger_title') %></h2>
    <div class="btn-row">
      <form method="POST" action="<%= href('/admin/users/' + (user.id) + '/reset-password') %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-sm btn-secondary" type="submit"><%= t('admin_user_reset_password') %></button>
      </form>
      <form method="POST" action="<%= href('/admin/users/' + (user.id) + '/active') %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="active" value="<%= user.isActive ? 'false' : 'true' %>">
        <button class="btn btn-sm btn-secondary" type="submit">
          <%= user.isActive ? t('admin_user_deactivate') : t('admin_user_activate') %>
        </button>
      </form>
      <% if (can('admin.grant')) { %>
        <form method="POST" action="<%= href('/admin/users/' + (user.id) + '/delete') %>"
              data-confirm="<%= t('admin_user_delete_confirm') %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-sm btn-danger" type="submit"><%= t('admin_user_delete') %></button>
        </form>
      <% } %>
    </div>
    <p class="help"><%= t('admin_user_delete_help') %></p>
  </div>
<% } %>
