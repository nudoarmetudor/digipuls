<%
const isEdit = mode === 'edit';
const action = isEdit ? '/admin/users/' + user.id : '/admin/users';
const val = (k) => (user && user[k] !== undefined && user[k] !== null ? user[k] : '');
%>
<h1><%= isEdit ? t('admin_user_edit_title') : t('admin_user_new_title') %></h1>
<p class="subtitle"><%= t('admin_user_form_subtitle') %></p>

<% if (errorMessage) { %><div class="flash flash-error" role="alert"><%= errorMessage %></div><% } %>

<form method="POST" action="<%= action %>">
  <div class="card">
    <h2 class="plain-heading"><%= t('admin_user_section_account') %></h2>

    <label for="f-name"><%= t('admin_user_name') %></label>
    <input type="text" id="f-name" name="name" value="<%= val('name') %>" required autocomplete="off">

    <label for="f-email"><%= t('login_email') %></label>
    <input type="email" id="f-email" name="email" value="<%= val('email') %>" required autocomplete="off">

    <label for="f-role"><%= t('admin_user_role') %></label>
    <select id="f-role" name="role" required>
      <% roles.forEach(function (r) { %>
        <option value="<%= r %>" <%= val('role') === r ? 'selected' : '' %>><%= t('role_' + r) %></option>
      <% }) %>
    </select>
    <p class="help"><%= t('admin_user_role_help') %></p>

    <div class="inline-fields">
      <div>
        <label for="f-schoolId"><%= t('admin_user_school') %></label>
        <select id="f-schoolId" name="schoolId">
          <option value="none">—</option>
          <% schools.forEach(function (s) { %>
            <option value="<%= s.id %>" <%= String(val('schoolId')) === String(s.id) ? 'selected' : '' %>><%= s.name %></option>
          <% }) %>
        </select>
        <p class="help"><%= t('admin_user_school_help') %></p>
      </div>
      <div>
        <label for="f-territoryId"><%= t('admin_user_territory') %></label>
        <select id="f-territoryId" name="territoryId">
          <option value="none">—</option>
          <% territories.forEach(function (tr) { %>
            <option value="<%= tr.id %>" <%= String(val('territoryId')) === String(tr.id) ? 'selected' : '' %>><%= tr.name %></option>
          <% }) %>
        </select>
        <p class="help"><%= t('admin_user_territory_help') %></p>
      </div>
    </div>
  </div>

  <div class="card">
    <h2 class="plain-heading"><%= t('admin_user_capabilities') %></h2>
    <p class="small"><%= t('admin_user_capabilities_help') %></p>

    <% capabilityGroups.forEach(function (group) { %>
      <fieldset class="cap-group">
        <legend><%= t('cap_group_' + group.key) %></legend>
        <div class="cap-list">
          <% group.capabilities.forEach(function (cap) { %>
            <%
              const id = 'cap-' + cap.replace(/\W/g, '-');
              // Which roles hand this out by default, so an admin can see at a
              // glance whether a tick is a deliberate exception or just the
              // role behaving normally.
              const defaultForRoles = roles.filter(function (r) { return (roleDefaults[r] || []).indexOf(cap) !== -1; });
            %>
            <div class="cap-item">
              <label class="checkbox" for="<%= id %>">
                <input type="checkbox" id="<%= id %>" name="capabilities" value="<%= cap %>"
                       <%= selected.has(cap) ? 'checked' : '' %>>
                <span>
                  <%= t('cap_' + cap) %>
                  <span class="cap-code"><%= cap %></span>
                  <% if (defaultForRoles.length) { %>
                    <span class="cap-default"><%= t('admin_user_cap_default', { roles: defaultForRoles.map(function (r) { return t('role_' + r); }).join(', ') }) %></span>
                  <% } %>
                </span>
              </label>
            </div>
          <% }) %>
        </div>
      </fieldset>
    <% }) %>
  </div>

  <div class="card">
    <div class="btn-row">
      <button class="btn" type="submit"><%= isEdit ? t('admin_user_save') : t('admin_user_create') %></button>
      <a class="btn btn-secondary" href="/admin/users"><%= t('cancel') %></a>
    </div>
    <% if (!isEdit) { %><p class="help"><%= t('admin_user_create_password_note') %></p><% } %>
  </div>
</form>

<% if (isEdit) { %>
  <div class="card">
    <h2 class="plain-heading"><%= t('admin_user_danger_title') %></h2>
    <div class="btn-row">
      <form method="POST" action="/admin/users/<%= user.id %>/reset-password">
        <button class="btn btn-sm btn-secondary" type="submit"><%= t('admin_user_reset_password') %></button>
      </form>
      <form method="POST" action="/admin/users/<%= user.id %>/active">
        <input type="hidden" name="active" value="<%= user.isActive ? 'false' : 'true' %>">
        <button class="btn btn-sm btn-secondary" type="submit">
          <%= user.isActive ? t('admin_user_deactivate') : t('admin_user_activate') %>
        </button>
      </form>
      <form method="POST" action="/admin/users/<%= user.id %>/delete"
            onsubmit="return confirm('<%= t('admin_user_delete_confirm') %>');">
        <button class="btn btn-sm btn-danger" type="submit"><%= t('admin_user_delete') %></button>
      </form>
    </div>
    <p class="help"><%= t('admin_user_delete_help') %></p>
  </div>
<% } %>
