<!DOCTYPE html>
<html lang="<%= lang %>" <%- prefsAttrs %>>
<head>
<%- include('partials/head') %>
</head>
<body>
  <a class="skip-link" href="#main"><%= t('skip_to_content') %></a>
  <%- include('partials/topbar') %>
  <div class="shell">
    <% if (currentUser) { %><%- include('partials/sidebar') %><% } %>
    <main id="main" tabindex="-1">
      <div class="container<%= typeof wide !== 'undefined' && wide ? ' wide' : '' %>">
        <%- body %>
      </div>
    </main>
  </div>
  <%- include('partials/footer') %>
  <script src="/static/js/a11y.js" defer></script>
<script src="/static/js/ui.js" defer></script>
  <% if (currentUser && can('feedback.submit')) { %>
    <script src="/static/js/feedback.js" defer></script>
  <% } %>
  <% if (currentUser && can('view.school')) { %>
    <%- include('partials/tour') %>
  <% } %>
</body>
</html>
