<!DOCTYPE html>
<html lang="<%= lang %>" <%- prefsAttrs %>>
<head>
<%- include('partials/head') %>
</head>
<body>
  <a class="skip-link" href="#main"><%= t('skip_to_content') %></a>
  <%- include('partials/topbar') %>
  <div class="shell">
    <% if (currentUser) { %><%- include('partials/sidebar') %><% } %>
    <main id="main" tabindex="-1">
      <div class="container<%= typeof wide !== 'undefined' && wide ? ' wide' : '' %>">
        <%# An administrator working inside an institution they hold no post at.
            Said on every page rather than only on the way in, because the one
            thing that must never happen is someone editing a school's record
            without noticing whose record it is. %>
        <% if (workspace && workspace.inEverySchool) { %>
          <div class="flash flash-info" role="status">
            <b><%= workspace.schoolName %></b> — <%= t('school_admin_notice') %>
          </div>
        <% } %>
        <%- body %>
      </div>
    </main>
  </div>
  <%- include('partials/footer') %>
  <script src="/static/js/a11y.js" defer></script>
<script src="/static/js/ui.js" defer></script>
  <% if (currentUser && can('feedback.submit')) { %>
    <script src="/static/js/feedback.js" defer></script>
  <% } %>
  <% if (currentUser && can('view.school')) { %>
    <%- include('partials/tour') %>
  <% } %>
</body>
</html>
