<%
/* The masthead.

   The route links moved into the left panel (partials/sidebar.ejs) — as a
   single row they had grown to thirteen items for an account holding every
   capability, which is not a menu so much as a wall. What stays here is
   everything about the person and this browser rather than about where you
   are going: the brand, which post this tab is working in, language, display
   settings, and sign-out. */
%>
<header class="topbar">
  <%- include('brand') %>
  <nav class="topbar-nav" aria-label="<%= t('nav_account_label') %>">
    <% if (currentUser && workspaces.length > 1) { %>
      <%- include('workspace-switch') %>
    <% } %>
    <% if (currentUser && can('feedback.submit')) { %>
      <%- include('feedback-toggle') %>
    <% } %>
    <%- include('lang-switch') %>
    <%- include('display-settings') %>
    <% if (currentUser) { %>
      <span class="userbox">
        <span><%= currentUser.name %></span>
        <% if (workspace && workspaces.length === 1) { %>
          <span class="role-chip"><%= t('role_' + workspace.role) %></span>
        <% } %>
      </span>
      <form action="/logout" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-sm btn-secondary" type="submit"><%= t('nav_logout') %></button>
      </form>
    <% } else { %>
      <a href="/login"><%= t('nav_login') %></a>
    <% } %>
  </nav>
</header>
