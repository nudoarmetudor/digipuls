<%
/* The guide's on/off switch, in the masthead next to the other per-person
   controls.

   Drawn by the server, not by the script, so it is in the page from the first
   paint and does not appear a moment late. It is hidden until public/js/tour.js
   claims it, so a browser with JavaScript off is not offered a button that
   would do nothing. */
%>
<button type="button" class="tour-toggle" data-tour="tour-toggle" data-tour-toggle hidden
        aria-expanded="false" aria-controls="tour-panel" title="<%= t('tour_open_hint') %>">
  <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none"
       stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="9"/>
    <path d="M9.5 9.5a2.5 2.5 0 1 1 3.4 2.3c-.6.25-.9.8-.9 1.45v.25"/>
    <path d="M12 17h.01"/>
  </svg>
  <span><%= t('tour_open') %></span>
</button>
