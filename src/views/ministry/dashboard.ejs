<%
const sortOptions = [
  ['name-asc', t('name_az')],
  ['A-desc', 'A ↓'], ['B-desc', 'B ↓'], ['C-desc', 'C ↓'], ['D-desc', 'D ↓'],
  ['A-asc', 'A ↑'], ['B-asc', 'B ↑'], ['C-asc', 'C ↑'], ['D-asc', 'D ↑'],
];
const domainKeys = ['A', 'B', 'C', 'D'];
const avgByDomain = { A: avgA, B: avgB, C: avgC, D: avgD };
%>
<h1><%= t('ministry_dashboard_title') %></h1>
<p class="subtitle"><%= t('ministry_dashboard_subtitle') %></p>

<div class="grid-3">
  <div class="card stat"><div class="num"><%= totalSchools %></div><div class="label"><%= t('stat_schools_provisioned') %></div></div>
  <div class="card stat"><div class="num"><%= confirmedCount %></div><div class="label"><%= t('stat_confirmed_data') %></div></div>
  <div class="card stat"><div class="num"><%= complianceCount %></div><div class="label"><%= t('stat_compliant') %></div></div>
</div>

<div class="card">
  <h2 class="plain-heading"><%= t('stat_avg_domain') %></h2>
  <div class="grid-4">
    <% domainKeys.forEach(d => { %>
      <div class="stat">
        <div class="num"><%= avgByDomain[d] %></div>
        <div class="label"><%= d %> — <%= t('domain_' + d + '_short') %></div>
      </div>
    <% }) %>
  </div>
</div>

<div class="card">
  <h2 class="plain-heading"><%= t('filters') %></h2>
  <form method="GET" action="/ministry">
    <div class="inline-fields">
      <div>
        <label for="f-band"><%= t('band') %></label>
        <select id="f-band" name="band">
          <option value="">—</option>
          <% bands.forEach(b => { %><option value="<%= b.key %>" <%= query.band===b.key?'selected':'' %>><%= b.key %></option><% }) %>
        </select>
      </div>
      <div>
        <label for="f-status"><%= t('status') %></label>
        <select id="f-status" name="status">
          <option value="">—</option>
          <option value="confirmed" <%= query.status==='confirmed'?'selected':'' %>><%= STATUS_LABELS.CONFIRMED %></option>
          <option value="draft" <%= query.status==='draft'?'selected':'' %>><%= STATUS_LABELS.DRAFT %></option>
          <option value="no_data" <%= query.status==='no_data'?'selected':'' %>><%= t('no_data') %></option>
        </select>
      </div>
      <div>
        <label for="f-compliance"><%= t('order675') %></label>
        <select id="f-compliance" name="compliance">
          <option value="">—</option>
          <option value="compliant" <%= query.compliance==='compliant'?'selected':'' %>><%= t('compliant') %></option>
          <option value="gap" <%= query.compliance==='gap'?'selected':'' %>><%= t('gap') %></option>
        </select>
      </div>
      <div>
        <label for="f-sort"><%= t('sort') %></label>
        <select id="f-sort" name="sort">
          <option value="">—</option>
          <% sortOptions.forEach(o => { %><option value="<%= o[0] %>" <%= query.sort===o[0]?'selected':'' %>><%= o[1] %></option><% }) %>
        </select>
      </div>
    </div>
    <div class="inline-fields" style="margin-top:0.4rem;">
      <% domainKeys.forEach(d => { %>
        <div>
          <label for="f-min<%= d %>"><%= t('min_level') %> <%= d %></label>
          <input type="number" id="f-min<%= d %>" name="min<%= d %>" min="0" max="5" value="<%= query['min' + d] || '' %>">
        </div>
      <% }) %>
    </div>
    <div class="btn-row" style="margin-top:0.8rem;">
      <button class="btn btn-sm" type="submit"><%= t('apply') %></button>
      <a class="btn btn-sm btn-secondary" href="/ministry"><%= t('reset') %></a>
      <a class="btn btn-sm btn-secondary" href="/ministry/export.csv?<%= new URLSearchParams(query).toString() %>"><%= t('export_csv') %></a>
    </div>
  </form>
</div>

<h2 id="all-schools"><%= t('all_schools') %> (<%= filteredCount %>/<%= totalSchools %>)</h2>
<div class="table-scroll">
  <table aria-labelledby="all-schools">
    <thead>
      <tr>
        <th scope="col"><%= t('school') %></th>
        <th scope="col"><%= t('territory') %></th>
        <th scope="col"><%= t('band') %></th>
        <th scope="col"><%= t('th_status') %></th>
        <% domainKeys.forEach(d => { %>
          <th scope="col"><abbr title="<%= t('domain_' + d + '_full') %>"><%= d %></abbr></th>
        <% }) %>
        <th scope="col"><%= t('order675') %></th>
        <th scope="col"><span class="visually-hidden"><%= t('details') %></span></th>
      </tr>
    </thead>
    <tbody>
      <% rows.forEach(r => { %>
        <tr>
          <th scope="row" style="background:none;font-weight:400;color:inherit;"><%= r.school.name %></th>
          <td><%= r.school.territory ? r.school.territory.name : '—' %></td>
          <td><%= r.school.enrolmentBand %></td>
          <td>
            <% if (!r.cycle) { %><span class="badge"><%= t('no_data') %></span>
            <% } else { %><span class="badge badge-<%= r.cycle.status.toLowerCase() %>"><%= STATUS_LABELS[r.cycle.status] %></span><% } %>
            <% if (r.hasNewerDraft) { %><br><span class="small"><%= t('newer_draft_note') %></span><% } %>
          </td>
          <% domainKeys.forEach(d => { %>
            <td><%= r.domainScores && r.domainScores[d] !== null ? r.domainScores[d].toFixed(1) : '—' %></td>
          <% }) %>
          <td>
            <% if (r.deviceCompliance && r.networkCompliance) { %>
              <% const ok = r.deviceCompliance.compliant && r.networkCompliance.compliant; %>
              <span class="badge badge-<%= ok ? 'pass' : 'fail' %>"><%= ok ? t('ok') : t('gap') %></span>
            <% } else { %>—<% } %>
          </td>
          <td>
            <a class="plain" href="/ministry/schools/<%= r.school.id %>">
              <%= t('details') %><span class="visually-hidden"> — <%= r.school.name %></span> <span aria-hidden="true">→</span>
            </a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
