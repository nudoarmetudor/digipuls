<h1><%= school.name %></h1>
<p class="subtitle">
  <%= t('sime_id') %>: <span class="mono"><%= school.simeId || '—' %></span>
  · <%= t('territory') %>: <%= school.territory ? school.territory.name : '—' %>
  · <%= t('enrolment') %>: <%= school.enrolmentTotal %> (<%= t('band') %> <%= school.enrolmentBand %>)
</p>

<% if (!latest) { %>
  <div class="card">
    <p><%= currentCycle ? t('ministry_no_official_yet') : t('ministry_no_cycle') %></p>
  </div>
<% } else { %>
  <% if (hasNewerDraft) { %>
    <div class="card card-flat">
      <p class="small"><%= t('ministry_newer_draft_detail', { n: currentCycle.cycleNumber }) %></p>
    </div>
  <% } %>

  <div class="card card-centre">
    <figure>
      <h2 class="plain-heading"><%= t('wheel_title') %> — <%= t('cycle') %> <%= latest.cycleNumber %></h2>
      <%- wheelSvg %>
      <figcaption><%= t('wheel_caption') %></figcaption>
    </figure>
  </div>

  <div class="card">
    <h2 class="plain-heading" id="ratings-h">
      <%= t('cycle') %> <%= latest.cycleNumber %> —
      <span class="badge badge-<%= latest.status.toLowerCase() %>"><%= STATUS_LABELS[latest.status] %></span>
    </h2>
    <div class="table-scroll">
      <table aria-labelledby="ratings-h">
        <thead>
          <tr>
            <th scope="col"><%= t('th_indicator') %></th>
            <th scope="col"><%= t('level_label') %></th>
            <th scope="col"><%= t('change') %></th>
            <th scope="col"><%= t('comment') %></th>
          </tr>
        </thead>
        <tbody>
          <% ['A','B','C','D'].forEach(d => { %>
            <% INDICATORS.filter(i => i.domain === d).forEach(ind => {
                 const r = latest.ratings.find(x => x.indicatorCode === ind.code);
            %>
              <tr>
                <th scope="row" style="background:none;font-weight:400;color:inherit;"><%= ind.code %> — <%= ind.name %></th>
                <td><% if (r && r.level !== null) { %><span class="badge badge-level<%= r.level %>"><%= t('level_label') %> <%= r.level %></span><% } else { %>—<% } %></td>
                <td><% if (r && r.changeState) { %><span class="badge badge-<%= r.changeState.toLowerCase() %>"><%= CHANGE_STATE_LABELS[r.changeState] %></span><% } %></td>
                <td class="small"><%= r ? (r.comment || '') : '' %></td>
              </tr>
            <% }) %>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="grid-2">
    <div class="card">
      <h2 class="plain-heading">D1 — <%= t('network_checklist') %></h2>
      <% if (networkCompliance) { %>
        <p><span class="badge badge-<%= networkCompliance.compliant ? 'pass' : 'fail' %>"><%= networkCompliance.compliant ? t('compliant') : t('non_compliant') %></span></p>
        <ul class="small">
          <% networkCompliance.checks.forEach(c => { %>
            <li><span aria-hidden="true"><%= c.pass ? '✓' : '✗' %></span>
              <span class="visually-hidden"><%= c.pass ? t('ok') : t('missing') %>:</span>
              <%= t(c.labelKey) %></li>
          <% }) %>
        </ul>
      <% } %>
    </div>
    <div class="card">
      <h2 class="plain-heading">D2 — <%= t('d2_heading') %></h2>
      <% if (deviceCompliance) { %>
        <p><span class="badge badge-<%= deviceCompliance.compliant ? 'pass' : 'fail' %>"><%= deviceCompliance.compliant ? t('compliant') : t('non_compliant') %></span></p>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th scope="col"><%= t('requirement') %></th>
                <th scope="col"><%= t('actual') %>/<%= t('required') %></th>
                <th scope="col"><%= t('th_status') %></th>
              </tr>
            </thead>
            <tbody>
              <% deviceCompliance.checks.forEach(c => { %>
                <tr>
                  <th scope="row" class="small" style="background:none;font-weight:400;color:inherit;"><%= t(c.labelKey, c.labelParams) %></th>
                  <td class="small"><%= c.actual %>/<%= c.required %></td>
                  <td><span class="badge badge-<%= c.pass ? 'pass' : 'fail' %>"><%= c.pass ? t('ok') : t('short') %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
  <p class="small"><%= t('order675_scope_note') %></p>

  <div class="card">
    <h2 class="plain-heading"><%= t('validation_records') %></h2>
    <% if (validations.length === 0) { %>
      <p class="small"><span class="badge badge-unvalidated"><%= t('validation_records') %></span> <%= t('no_validation') %></p>
    <% } else { %>
      <ul class="small">
        <% validations.forEach(v => { %>
          <li><b><%= v.reviewerType %></b> (<%= v.reviewerName %>): <%= v.verdict %><% if (v.reliabilityNote) { %> — <%= v.reliabilityNote %><% } %><% if (v.notes) { %> — “<%= v.notes %>”<% } %></li>
        <% }) %>
      </ul>
    <% } %>
  </div>

  <% if (latest.plan) { %>
    <div class="card">
      <h2 class="plain-heading"><%= t('digital_dev_plan') %></h2>
      <p class="small"><%= latest.plan.publishedAt ? t('published_on') + ' ' + new Date(latest.plan.publishedAt).toLocaleDateString(lang) : STATUS_LABELS.DRAFT %></p>
      <ul>
        <% latest.plan.priorities.forEach(p => { %>
          <li><%= p.indicatorCode %>: <%= t('level_label') %> <%= p.currentLevel %> <span aria-hidden="true">→</span> <%= p.targetLevel %> — <%= p.rationale %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <h2 id="cycles-h"><%= t('school_cycle_history') %></h2>
  <div class="table-scroll">
    <table aria-labelledby="cycles-h">
      <thead>
        <tr><th scope="col"><%= t('th_cycle') %></th><th scope="col"><%= t('th_status') %></th><th scope="col"><%= t('th_confirmed') %></th></tr>
      </thead>
      <tbody>
        <% school.cycles.forEach(c => { %>
          <tr>
            <th scope="row" style="background:none;font-weight:400;color:inherit;">#<%= c.cycleNumber %></th>
            <td><span class="badge badge-<%= c.status.toLowerCase() %>"><%= STATUS_LABELS[c.status] %></span></td>
            <td><%= c.confirmedAt ? new Date(c.confirmedAt).toLocaleDateString(lang) : '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
