<h1>Order 675 compliance monitor</h1>
<p class="subtitle">Directly fulfils the Ministry's existing legal monitoring requirement under Order 675/2024. <%= rows.length %> of <%= allCount %> confirmed schools have a compliance gap.</p>

<table>
  <tr><th>School</th><th>Territory</th><th>Network (D1)</th><th>Devices (D2)</th><th></th></tr>
  <% rows.forEach(r => { %>
    <tr>
      <td><%= r.school.name %></td>
      <td><%= r.school.territory ? r.school.territory.name : '—' %></td>
      <td><span class="badge badge-<%= r.networkCompliance.compliant ? 'pass' : 'fail' %>"><%= r.networkCompliance.compliant ? 'OK' : 'GAP' %></span></td>
      <td><span class="badge badge-<%= r.deviceCompliance.compliant ? 'pass' : 'fail' %>"><%= r.deviceCompliance.compliant ? 'OK' : 'GAP' %></span></td>
      <td><a class="plain" href="/ministry/schools/<%= r.school.id %>">Details →</a></td>
    </tr>
  <% }) %>
</table>
<% if (rows.length === 0) { %><div class="card"><p>All confirmed schools are compliant.</p></div><% } %>
