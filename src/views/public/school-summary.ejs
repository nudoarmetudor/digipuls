<% const domainKeys = ['A', 'B', 'C', 'D']; %>
<h1><%= school.name %></h1>
<p class="subtitle"><%= t('public_summary_subtitle') %></p>

<% if (!hasData) { %>
  <div class="card"><p><%= t('public_no_cycle') %></p></div>
<% } else { %>
  <div class="card card-centre">
    <figure>
      <h2 class="plain-heading"><%= t('wheel_title') %> — <%= t('public_four_domains') %></h2>
      <%- wheelSvg %>
      <figcaption><%= t('wheel_domains_caption') %></figcaption>
    </figure>
  </div>

  <div class="card">
    <h2 class="plain-heading"><%= t('public_domain_summary') %></h2>
    <div class="grid-4">
      <% domainKeys.forEach(d => { %>
        <div class="stat">
          <div class="num" style="font-size:1rem;"><%= domains[d] || '—' %></div>
          <div class="label"><%= d %> — <%= t('domain_' + d + '_short') %></div>
        </div>
      <% }) %>
    </div>
    <p style="margin-top:1rem;">
      <%= t('public_min_quantities') %>:
      <span class="badge badge-<%= compliant ? 'pass' : 'fail' %>"><%= compliant ? t('public_met') : t('public_not_yet_met') %></span>
    </p>
    <p>
      <%= t('public_plan_label') %>:
      <span class="badge badge-<%= hasPlan ? 'pass' : 'fail' %>"><%= hasPlan ? t('public_exists') : t('public_not_published') %></span>
    </p>
  </div>

  <% if (richDetail) { %>
    <div class="card">
      <h2 class="plain-heading" id="rich-h"><%= t('public_additional_detail') %></h2>
      <div class="table-scroll">
        <table aria-labelledby="rich-h">
          <thead>
            <tr><th scope="col"><%= t('domain_label') %></th><th scope="col"><%= t('public_avg_level') %></th></tr>
          </thead>
          <tbody>
            <% domainKeys.forEach(d => { %>
              <tr>
                <th scope="row" style="background:none;font-weight:400;color:inherit;"><%= d %> — <%= t('domain_' + d + '_full') %></th>
                <td><%= richDetail[d] !== null ? richDetail[d].toFixed(1) : '—' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
<% } %>

<a class="btn btn-secondary" href="/public-view/schools"><span aria-hidden="true">←</span> <%= t('public_back_to_search') %></a>
