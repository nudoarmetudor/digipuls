<!DOCTYPE html>
<html lang="<%= lang %>" <%- prefsAttrs %>>
<head>
<%- include('../partials/head') %>
</head>
<body>
  <a class="skip-link" href="#main"><%= t('skip_to_content') %></a>
  <header class="topbar">
    <%- include('../partials/brand') %>
    <nav class="topbar-nav" aria-label="<%= t('nav_primary_label') %>">
      <%- include('../partials/lang-switch') %>
      <%- include('../partials/display-settings') %>
      <form action="/logout" method="POST">
        <button class="btn btn-sm btn-secondary" type="submit"><%= t('nav_logout') %></button>
      </form>
    </nav>
  </header>
  <main id="main" tabindex="-1">
    <div class="container narrow">
      <div class="card">
        <h1><%= t('change_password_title') %></h1>
        <p class="subtitle"><%= t('change_password_subtitle') %></p>
        <% if (error) { %><div class="flash flash-error" role="alert"><%= error %></div><% } %>
        <form method="POST" action="/change-password">
          <label for="new-password"><%= t('change_password_new_label') %></label>
          <input type="password" id="new-password" name="newPassword" minlength="10"
                 autocomplete="new-password" required autofocus>
          <label for="confirm-password"><%= t('change_password_confirm_label') %></label>
          <input type="password" id="confirm-password" name="confirmPassword" minlength="10"
                 autocomplete="new-password" required>
          <div style="margin-top:1.2rem;"><button class="btn" type="submit"><%= t('change_password_button') %></button></div>
        </form>
      </div>
    </div>
  </main>
  <%- include('../partials/footer') %>
  <script src="/static/js/a11y.js" defer></script>
</body>
</html>
