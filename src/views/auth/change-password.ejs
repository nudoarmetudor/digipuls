<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <title>Set a new password — DigiPuls</title>
  <link rel="stylesheet" href="/static/css/style.css">
</head>
<body>
  <div class="topbar">
    <a href="/" class="brand">Digi<span>Puls</span></a>
  </div>
  <div class="container" style="max-width: 420px; margin-top: 3rem;">
    <div class="card">
      <h1><%= t('change_password_title') %></h1>
      <p class="subtitle"><%= t('change_password_subtitle') %></p>
      <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>
      <form method="POST" action="/change-password">
        <label><%= t('change_password_new_label') %></label>
        <input type="password" name="newPassword" minlength="10" required autofocus>
        <label><%= t('change_password_confirm_label') %></label>
        <input type="password" name="confirmPassword" minlength="10" required>
        <div style="margin-top:1.2rem;"><button class="btn" type="submit"><%= t('change_password_button') %></button></div>
      </form>
    </div>
  </div>
</body>
</html>
