<h1><%= t('plan_title') %></h1>
<p class="subtitle"><%= school.name %> · <%= t('cycle') %> <%= cycle.cycleNumber %></p>

<% if (!plan) { %>
  <div class="card">
    <h2 class="plain-heading"><%= t('plan_not_open') %></h2>
    <% if (!cycleConfirmed) { %>
      <p><%= t('plan_needs_confirmed') %></p>
    <% } else if (canManage) { %>
      <p><%= t('plan_open_intro') %></p>
      <form method="POST" action="<%= href('/school/cycles/' + (cycle.id) + '/plan/open') %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn" type="submit"><%= t('plan_open') %></button>
      </form>
    <% } else { %>
      <p><%= t('plan_open_needs_principal') %></p>
    <% } %>
  </div>
<% } else { %>

  <div class="card card-flat">
    <p style="margin:0;">
      <b><%= t('plan_period') %></b>
      <%= plan.startsOn ? new Date(plan.startsOn).toLocaleDateString(lang) : '—' %>
      —
      <%= plan.endsOn ? new Date(plan.endsOn).toLocaleDateString(lang) : '—' %>
      <% if (plan.publishedAt) { %>
        · <span class="badge badge-confirmed"><%= t('plan_published_on') %> <%= new Date(plan.publishedAt).toLocaleDateString(lang) %></span>
      <% } else { %>
        · <span class="badge badge-draft"><%= t('plan_unpublished') %></span>
      <% } %>
    </p>
    <p class="small" style="margin:.4rem 0 0;">
      <%= t('plan_summary', {
        advancing: summary.advancing,
        maintaining: summary.maintaining,
        initiatives: summary.initiatives,
      }) %>
    </p>
    <% if (summary.withoutInitiatives.length) { %>
      <p class="small"><%= t('plan_missing_initiatives', { codes: summary.withoutInitiatives.join(', ') }) %></p>
    <% } %>
  </div>

  <p><%= t('plan_intro') %></p>

  <div class="table-scroll">
    <table>
      <caption><%= t('plan_parameters_caption') %></caption>
      <thead>
        <tr>
          <th scope="col"><%= t('indicator') %></th>
          <th scope="col"><%= t('plan_now') %></th>
          <th scope="col"><%= t('plan_intent') %></th>
          <th scope="col"><%= t('plan_target') %></th>
          <th scope="col"><%= t('plan_initiatives') %></th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function (row) { %>
          <tr>
            <th scope="row" style="background:none;font-weight:400;color:inherit;">
              <a href="<%= href('/school/cycles/' + (cycle.id) + '/plan/parameter/' + (row.indicator.code)) %>">
                <b><%= row.indicator.code %></b> — <%= row.indicator.name %>
              </a>
            </th>
            <td class="num"><%= row.currentLevel === null ? '—' : row.currentLevel %></td>
            <td>
              <% if (row.advancing) { %>
                <span class="badge badge-grew"><%= t('plan_intent_advance') %></span>
              <% } else { %>
                <span class="badge badge-maintained"><%= t('plan_intent_maintain') %></span>
              <% } %>
            </td>
            <td class="num"><%= row.targetLevel === null ? '—' : row.targetLevel %></td>
            <td>
              <%= row.initiativeCount %>
              <% if (row.needsInitiatives) { %>
                <span class="badge badge-unvalidated"><%= t('plan_none_yet') %></span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <% if (canManage) { %>
    <div class="card">
      <h2 class="plain-heading"><%= t('plan_details') %></h2>
      <form method="POST" action="<%= href('/school/cycles/' + (cycle.id) + '/plan/details') %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="inline-fields">
          <div>
            <label for="plan-starts"><%= t('plan_starts') %></label>
            <input type="date" id="plan-starts" name="startsOn"
                   value="<%= plan.startsOn ? new Date(plan.startsOn).toISOString().slice(0, 10) : '' %>">
          </div>
          <div>
            <label for="plan-ends"><%= t('plan_ends') %></label>
            <input type="date" id="plan-ends" name="endsOn"
                   value="<%= plan.endsOn ? new Date(plan.endsOn).toISOString().slice(0, 10) : '' %>">
          </div>
        </div>

        <label for="plan-funding"><%= t('funding_source') %></label>
        <input type="text" id="plan-funding" name="fundingSource" value="<%= plan.fundingSource || '' %>">

        <label for="plan-authority"><%= t('approving_authority') %></label>
        <input type="text" id="plan-authority" name="approvingAuthority" value="<%= plan.approvingAuthority || '' %>">

        <label for="plan-consult"><%= t('stakeholder_notes') %></label>
        <textarea id="plan-consult" name="stakeholderConsultationNotes"><%= plan.stakeholderConsultationNotes || '' %></textarea>

        <div class="btn-row" style="margin-top:.8rem;">
          <button class="btn btn-sm" type="submit"><%= t('plan_save_details') %></button>
        </div>
      </form>
    </div>
  <% } %>

  <div class="btn-row" style="margin-top:1.2rem;">
    <a class="btn btn-secondary" href="<%= href('/school/cycles/' + (cycle.id) + '/plan/document') %>"><%= t('plan_view_document') %></a>
    <% if (canPublish && !plan.publishedAt) { %>
      <form method="POST" action="<%= href('/school/cycles/' + (cycle.id) + '/plan/publish') %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn" type="submit"><%= t('plan_publish_button') %></button>
      </form>
    <% } %>
  </div>
<% } %>
