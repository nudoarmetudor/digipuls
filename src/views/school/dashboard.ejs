<h1><%= school.name %></h1>
<p class="subtitle">
  <%= t('sime_id') %>: <span class="mono"><%= school.simeId || '—' %></span>
  · <%= t('enrolment') %>: <%= school.enrolmentTotal %> (<%= t('band') %> <%= school.enrolmentBand %>)
</p>

<% if (cycles.length === 0) { %>
  <div class="card">
    <h2 class="plain-heading"><%= t('school_welcome_title') %></h2>
    <p><%= t('school_welcome_body') %></p>
    <form method="POST" action="/school/cycles/start">
      <button class="btn" type="submit"><%= t('school_start_first_cycle') %></button>
    </form>
  </div>
<% } else { %>
  <% if (latest.status === 'DRAFT') { %>
    <div class="card card-info">
      <h2 class="plain-heading"><%= t('cycle') %> <%= latest.cycleNumber %> — <%= t('school_cycle_in_progress') %></h2>
      <p><%= latest.ratings.filter(r => r.level !== null).length %> <%= t('school_indicators_rated') %></p>
      <a class="btn" href="/school/cycles/<%= latest.id %>"><%= t('school_continue_assessment') %></a>
    </div>
  <% } else { %>
    <div class="card card-ok">
      <h2 class="plain-heading"><%= t('cycle') %> <%= latest.cycleNumber %> — <%= t('school_cycle_confirmed') %></h2>
      <p class="small"><%= t('school_confirmed_on') %> <%= new Date(latest.confirmedAt).toLocaleDateString(lang) %>. <%= t('school_next_renewal') %></p>
      <div class="btn-row">
        <a class="btn btn-secondary" href="/school/cycles/<%= latest.id %>"><%= t('school_view_assessment') %></a>
        <a class="btn btn-secondary" href="/school/cycles/<%= latest.id %>/plan"><%= t('school_view_plan') %></a>
        <form method="POST" action="/school/cycles/start">
          <button class="btn" type="submit"><%= t('school_start_renewal') %></button>
        </form>
      </div>
    </div>
  <% } %>

  <h2 id="cycle-history"><%= t('school_cycle_history') %></h2>
  <div class="table-scroll">
    <table aria-labelledby="cycle-history">
      <thead>
        <tr>
          <th scope="col"><%= t('th_cycle') %></th>
          <th scope="col"><%= t('th_status') %></th>
          <th scope="col"><%= t('th_started') %></th>
          <th scope="col"><%= t('th_confirmed') %></th>
          <th scope="col"><%= t('th_plan') %></th>
          <th scope="col"><span class="visually-hidden"><%= t('details') %></span></th>
        </tr>
      </thead>
      <tbody>
        <% cycles.forEach(c => { %>
          <tr>
            <td>#<%= c.cycleNumber %></td>
            <td><span class="badge badge-<%= c.status.toLowerCase() %>"><%= STATUS_LABELS[c.status] %></span></td>
            <td><%= new Date(c.startedAt).toLocaleDateString(lang) %></td>
            <td><%= c.confirmedAt ? new Date(c.confirmedAt).toLocaleDateString(lang) : '—' %></td>
            <td><%= c.plan ? (c.plan.publishedAt ? t('plan_published') : STATUS_LABELS.DRAFT) : '—' %></td>
            <td>
              <a class="plain" href="/school/cycles/<%= c.id %>">
                <%= t('open') %><span class="visually-hidden"> — <%= t('cycle') %> <%= c.cycleNumber %></span> <span aria-hidden="true">→</span>
              </a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
