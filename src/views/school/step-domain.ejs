<h1><%= school.name %> — <%= lang==='ro'?'Ciclul':'Cycle' %> <%= cycle.cycleNumber %></h1>
<%- include('_step-nav', { activeStep: domainCode }) %>

<% if (errorMessage) { %><div class="flash flash-error"><%= errorMessage %></div><% } %>

<div class="card">
  <h2 style="margin-top:0;border:none;"><%= t('domain_label') %> <%= domainCode %> — <%= domainName %></h2>
  <p class="small"><%= domainIntro %></p>
  <div class="progress-bar-track"><div class="progress-bar-fill" style="width:<%= Math.round(100*ratedInDomain/totalInDomain) %>%"></div></div>
  <p class="small"><%= ratedInDomain %>/<%= totalInDomain %> <%= lang==='ro'?'evaluați în acest domeniu':'rated in this domain' %></p>
</div>

<% indicators.forEach(ind => { %>
  <%- include('_indicator-block', { ind, cycle, lang, t, CHANGE_STATE_LABELS }) %>
<% }) %>

<div class="card" style="text-align:center;">
  <a class="btn btn-secondary" href="/school/cycles/<%= cycle.id %>"><%= lang==='ro'?'← Înapoi la prezentare generală':'← Back to overview' %></a>
</div>
