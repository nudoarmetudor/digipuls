<h1><%= school.name %> — <%= t('cycle') %> <%= cycle.cycleNumber %></h1>
<p class="subtitle">
  <span class="badge badge-<%= cycle.status.toLowerCase() %>"><%= STATUS_LABELS[cycle.status] %></span>
  <% if (isContinuation) { %> · <%= t('continuation_note') %><% } %>
</p>

<div class="card card-flat">
  <p class="small" style="margin:0;"><%= t('cycle_collaboration_note') %></p>
</div>

<%- include('../partials/_cycle-record-notes', { cycle }) %>

<%- include('_step-nav', { activeStep: null }) %>

<% if (cycle.status === 'CONFIRMED') { %>
  <div class="card">
    <h2 class="plain-heading"><%= t('public_view_summary') %></h2>
    <p style="margin:0 0 .5rem;">
      <% if (cycle.publishedAt) { %>
        <span class="badge badge-confirmed"><%= t('publish_state_published') %></span>
      <% } else { %>
        <span class="badge badge-draft"><%= t('publish_state_unpublished') %></span>
      <% } %>
    </p>
    <p class="small"><%= t('publish_note') %></p>
    <% if (can('school.publish')) { %>
      <form method="POST" data-tour="publish-assessment" action="<%= href('/school/cycles/' + (cycle.id) + '/publish') %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="publish" value="<%= cycle.publishedAt ? 'false' : 'true' %>">
        <button class="btn btn-sm" type="submit">
          <%= cycle.publishedAt ? t('unpublish_assessment') : t('publish_assessment') %>
        </button>
      </form>
    <% } %>
  </div>

  <div class="card">
    <h2 class="plain-heading"><%= t('plan_title') %></h2>
    <p class="small"><%= t('plan_overview_note') %></p>
    <div class="btn-row">
      <a class="btn btn-sm" href="<%= href('/school/cycles/' + (cycle.id) + '/plan') %>"><%= t('school_view_plan') %></a>
      <a class="btn btn-sm btn-secondary" href="<%= href('/school/cycles/' + (cycle.id) + '/document') %>"><%= t('assessment_doc_link') %></a>
    </div>
  </div>
<% } %>

<% if (cycle.status === 'CONFIRMED') { %>
  <div class="card" id="closing">
    <h2 class="plain-heading"><%= t('close_title') %></h2>
    <% if (cycle.closedAt) { %>
      <p>
        <span class="badge badge-confirmed"><%= t('status_closed') %></span>
        <%= t('closed_on', { date: new Date(cycle.closedAt).toLocaleDateString(lang), name: cycle.closedBy ? cycle.closedBy.name : '—' }) %>
      </p>
      <% if (cycle.closingNote) { %><p class="small"><%= cycle.closingNote %></p><% } %>
      <p class="small"><%= t('close_nothing_locked') %></p>
      <% if (can('school.manage')) { %>
        <form method="POST" action="<%= href('/school/cycles/' + (cycle.id) + '/reopen') %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-sm btn-secondary" type="submit"><%= t('reopen_button') %></button>
        </form>
      <% } %>
    <% } else { %>
      <p class="small"><%= t('close_intro') %></p>
      <% const gaps = [];
         if (!closing.hasPlan) gaps.push(t('close_no_plan'));
         else {
           if (!closing.interimPublished) gaps.push(t('close_interim_missing'));
           if (!closing.finalPublished) gaps.push(t('close_final_missing'));
         } %>
      <% if (gaps.length) { %>
        <ul class="small"><% gaps.forEach(function (g) { %><li><%= g %></li><% }) %></ul>
      <% } %>
      <% if (can('school.manage')) { %>
        <form method="POST" data-tour="close-cycle" action="<%= href('/school/cycles/' + (cycle.id) + '/close') %>"
              data-confirm="<%= t('close_confirm') %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label for="close-note"><%= t('close_note_label') %></label>
          <textarea id="close-note" name="note"></textarea>
          <div class="btn-row" style="margin-top:.5rem;">
            <button class="btn btn-sm" type="submit"><%= t('close_button') %></button>
          </div>
        </form>
      <% } %>
    <% } %>
  </div>
<% } %>

<div class="card">
  <h2 class="plain-heading"><%= t('reconcile_title') %></h2>
  <p class="small"><%= t('reconcile_overview_note') %></p>
  <div class="btn-row">
    <a class="btn btn-sm" data-tour="reconcile-link" href="<%= href('/school/cycles/' + (cycle.id) + '/reconcile') %>"><%= t('nav_reconcile') %></a>
    <a class="btn btn-sm btn-secondary" data-tour="delegation-link" href="<%= href('/school/cycles/' + (cycle.id) + '/delegation') %>"><%= t('nav_delegation') %></a>
  </div>
</div>

<div class="card">
  <h2 class="plain-heading"><%= t('overall_progress') %></h2>
  <%
    const pct = progress.total ? Math.round((100 * progress.rated) / progress.total) : 0;
  %>
  <div class="progress-bar-track" role="progressbar" aria-valuenow="<%= progress.rated %>"
       aria-valuemin="0" aria-valuemax="<%= progress.total %>"
       aria-label="<%= progress.rated %>/<%= progress.total %> <%= t('indicators_rated') %>">
    <div class="progress-bar-fill" style="width:<%= pct %>%"></div>
  </div>
  <p class="small"><%= progress.rated %>/<%= progress.total %> <%= t('indicators_rated') %></p>
</div>

<div class="card card-centre">
  <figure>
    <h2 class="plain-heading"><%= t('wheel_title') %></h2>
    <%- wheelSvg %>
    <%# Only when there is actually a dotted line to explain. %>
    <% if (wheelSvg && wheelSvg.indexOf('stroke-dasharray') !== -1) { %>
      <p class="small wheel-plan-legend"><%= t('wheel_plan_legend') %></p>
    <% } %>
    <figcaption><%= t('wheel_caption') %></figcaption>
  </figure>
</div>

<div class="card">
  <h2 class="plain-heading"><%= t('legend') %></h2>
  <ul class="step-legend">
    <li><span class="step-pill step-grey"><span class="step-dot" aria-hidden="true"></span><%= t('not_started') %></span></li>
    <li><span class="step-pill step-blue"><span class="step-dot" aria-hidden="true"></span><%= t('in_progress') %></span></li>
    <li><span class="step-pill step-red"><span class="step-dot" aria-hidden="true"></span><%= t('needs_attention') %></span></li>
    <li><span class="step-pill step-green"><span class="step-dot" aria-hidden="true"></span><%= t('complete') %></span></li>
  </ul>
</div>
