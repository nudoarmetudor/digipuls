<h1><%= t('history_title') %></h1>
<p class="subtitle"><%= school.name %> — <%= cycles.length %> <%= t('history_confirmed_cycles') %></p>

<% if (cycles.length === 0) { %>
  <div class="card"><p><%= t('history_none') %></p></div>
<% } else { %>
  <div class="card">
    <h2 class="plain-heading"><%= t('wheel_by_cycle') %></h2>
    <div style="display:flex; gap:1.5rem; flex-wrap:wrap; justify-content:center;">
      <% cycleWheels.forEach(cw => { %>
        <figure style="text-align:center;">
          <figcaption class="small" style="font-weight:600;margin:0 0 0.3rem;"><%= t('cycle') %> <%= cw.cycleNumber %></figcaption>
          <%- cw.svg %>
        </figure>
      <% }) %>
    </div>
  </div>

  <% ['A','B','C','D'].forEach(domain => { %>
    <h2 id="hist-<%= domain %>"><%= t('domain_label') %> <%= domain %> — <%= t('domain_' + domain + '_short') %></h2>
    <div class="table-scroll">
      <table aria-labelledby="hist-<%= domain %>">
        <thead>
          <tr>
            <th scope="col"><%= t('th_indicator') %></th>
            <% cycles.forEach(c => { %><th scope="col"><%= t('cycle') %> <%= c.cycleNumber %></th><% }) %>
          </tr>
        </thead>
        <tbody>
          <% history.filter(h => h.domain === domain).forEach(h => { %>
            <tr>
              <th scope="row" style="background:none;font-weight:400;color:inherit;"><%= h.code %> — <%= h.name %></th>
              <% h.series.forEach(s => { %>
                <td>
                  <% if (s.level !== null) { %>
                    <span class="badge badge-level<%= s.level %>"><%= t('level_label') %> <%= s.level %></span>
                    <% if (s.changeState) { %><span class="badge badge-<%= s.changeState.toLowerCase() %>"><%= CHANGE_STATE_LABELS[s.changeState] %></span><% } %>
                  <% } else { %>—<% } %>
                </td>
              <% }) %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% }) %>
<% } %>
