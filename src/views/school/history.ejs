<h1><%= t('history_title') %></h1>
<p class="subtitle"><%= school.name %> — <%= cycles.length %> <%= lang==='ro' ? 'ciclu(ri) confirmat(e)' : 'confirmed cycle(s)' %></p>

<% if (cycles.length === 0) { %>
  <div class="card"><p><%= lang==='ro' ? 'Niciun ciclu confirmat încă.' : 'No confirmed cycles yet.' %></p></div>
<% } else { %>
  <div class="card">
    <h2 style="margin-top:0;border:none;"><%= t('wheel_by_cycle') %></h2>
    <div style="display:flex; gap:1.5rem; flex-wrap:wrap; justify-content:center;">
      <% cycleWheels.forEach(cw => { %>
        <div style="text-align:center;">
          <div class="small" style="font-weight:600;"><%= lang==='ro'?'Ciclul':'Cycle' %> <%= cw.cycleNumber %></div>
          <%- cw.svg %>
        </div>
      <% }) %>
    </div>
  </div>
  <% ['A','B','C','D'].forEach(domain => { %>
    <h2><%= t('domain_label') %> <%= domain %></h2>
    <table>
      <tr>
        <th><%= t('th_indicator') %></th>
        <% cycles.forEach(c => { %><th><%= lang==='ro'?'Ciclul':'Cycle' %> <%= c.cycleNumber %></th><% }) %>
      </tr>
      <% history.filter(h => h.domain === domain).forEach(h => { %>
        <tr>
          <td><%= h.code %> — <%= h.name %></td>
          <% h.series.forEach(s => { %>
            <td>
              <% if (s.level !== null) { %>
                <span class="badge badge-level<%= s.level %>">L<%= s.level %></span>
                <% if (s.changeState) { %><span class="badge badge-<%= s.changeState.toLowerCase() %>"><%= CHANGE_STATE_LABELS[s.changeState] %></span><% } %>
              <% } else { %>—<% } %>
            </td>
          <% }) %>
        </tr>
      <% }) %>
    </table>
  <% }) %>
<% } %>
