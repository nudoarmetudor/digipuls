<%
/* One indicator: the level picker, its comment box, and (from level 2 up) the
   evidence sub-form. Every control gets a real id/for pair — ids are prefixed
   with the indicator code because 19 of these render on one page and duplicate
   ids would send every label to the first block. */
const evidenceTypes = [
  ['document', t('ev_document')],
  ['observation_log', t('ev_observation_log')],
  ['survey', t('ev_survey')],
  ['usage_data', t('ev_usage_data')],
  ['it_audit', t('ev_it_audit')],
  ['photo', t('ev_photo')],
  ['minutes', t('ev_minutes')],
  ['certification', t('ev_certification')],
  ['external_validation', t('ev_external_validation')],
];
%>
<%
/* On one of the two sides of a draft, the picker is this person's own reading
   (`myReading`); elsewhere it is the record being shown (`rating`). */
const personal = ind.myReading !== undefined;
const shownLevel = personal
  ? (ind.myReading && Number.isInteger(ind.myReading.level) ? ind.myReading.level : null)
  : (ind.rating && Number.isInteger(ind.rating.level) ? ind.rating.level : null);
const shownComment = personal
  ? (ind.myReading ? (ind.myReading.comment || '') : '')
  : (ind.rating ? (ind.rating.comment || '') : '');
const sideLevelNow = ind.rating && Number.isInteger(ind.rating.level) ? ind.rating.level : null;
%>
<section class="indicator-block" id="ind-<%= ind.code %>" aria-labelledby="ind-<%= ind.code %>-h">
  <h3 id="ind-<%= ind.code %>-h"><%= ind.code %>. <%= ind.name %></h3>
  <p class="small"><%= ind.description %></p>

  <%# Who took this parameter on. A name here is a note about who is gathering
      the evidence, not a restriction on who may record it. %>
  <% if (ind.assignees && ind.assignees.length) { %>
    <p class="small"><%= t('delegation_taken_by', { names: ind.assignees.map(function (a) { return a.name; }).join(', ') }) %></p>
  <% } %>

  <%# Who else on this side has answered. Their levels are shown once this
      person has given their own, so nobody simply copies a colleague. %>
  <% if (personal && ind.sideReadings && ind.sideReadings.length) {
       const others = ind.sideReadings.filter(function (r) { return !ind.myReading || r.userId !== ind.myReading.userId; }); %>
    <% if (others.length || shownLevel !== null) { %>
      <p class="small">
        <% if (shownLevel === null) { %>
          <%= t('side_answered_by', { names: others.map(function (r) { return r.name; }).join(', ') }) %>
          <span class="help"><%= t('side_levels_after_you') %></span>
        <% } else { %>
          <%= t('side_readings_label') %>
          <%= ind.sideReadings.map(function (r) { return r.name + ' ' + r.level; }).join(' · ') %>
          <% if (sideLevelNow !== null) { %> — <b><%= t('side_reading_value', { n: sideLevelNow }) %></b><% } %>
        <% } %>
      </p>
    <% } %>
  <% } %>

  <% if (ind.priorRating) { %>
    <p class="small">
      <%= t('previous_cycle') %>
      <span class="badge badge-level<%= ind.priorRating.level %>"><%= t('level_label') %> <%= ind.priorRating.level %></span>
      <% if (ind.rating && ind.rating.changeState) { %>
        <span aria-hidden="true">→</span> <%= t('assessment_now') %>
        <span class="badge badge-level<%= ind.rating.level %>"><%= t('level_label') %> <%= ind.rating.level %></span>
        <span class="badge badge-<%= ind.rating.changeState.toLowerCase() %>"><%= CHANGE_STATE_LABELS[ind.rating.changeState] %></span>
      <% } %>
    </p>
  <% } %>

  <form method="POST" action="<%= href('/school/cycles/' + (cycle.id) + '/ratings/' + (ind.code)) %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="returnStep" value="<%= ind.domain %>">
    <fieldset style="border:none;padding:0;margin:0;">
      <legend class="visually-hidden"><%= t('level_options_label') %> — <%= ind.code %></legend>
      <div class="level-picker" data-tour="level-picker">
        <% ind.levels.forEach(lv => { %>
          <label class="level-option<%= shownLevel === lv.level ? ' selected' : '' %>">
            <input type="radio" name="level" value="<%= lv.level %>" class="visually-hidden"
              <%= shownLevel === lv.level ? 'checked' : '' %>
              data-desc="<%= lv.description %>">
            <span class="lv-num"><%= lv.level %></span> — <%= lv.levelName %>
          </label>
        <% }) %>
      </div>
    </fieldset>
    <div class="level-desc">
      <span class="level-desc-target" role="status" aria-live="polite"><%= shownLevel !== null ? ind.levels[shownLevel].description : t('assessment_select_level') %></span>
    </div>
    <label for="comment-<%= ind.code %>"><%= t('assessment_comment_label') %></label>
    <textarea id="comment-<%= ind.code %>" name="comment"><%= shownComment %></textarea>
    <div style="margin-top:0.6rem;">
      <button class="btn btn-sm" type="submit">
        <%= t('assessment_save_rating') %><span class="visually-hidden"> — <%= ind.code %></span>
      </button>
    </div>
  </form>

  <%# Evidence can be attached at any level once one is chosen; from level 2
      upward it is required for confirmation. %>
  <% if (shownLevel !== null || sideLevelNow !== null) {
       const evidenceRequired = (shownLevel !== null && shownLevel >= 2) || (sideLevelNow !== null && sideLevelNow >= 2); %>
    <div class="evidence-block" data-tour="evidence">
      <h4 style="font-size:0.95rem;margin:0 0 0.4rem;">
        <%= evidenceRequired ? t('assessment_evidence_required') : t('evidence_heading') %>
        <span class="small"><%= evidenceRequired ? t('assessment_evidence_required_note') : t('assessment_evidence_optional_note') %></span>
      </h4>
      <% if (ind.rating.evidences && ind.rating.evidences.length) { %>
        <%- include('../partials/_evidence-list', {
          evidences: ind.rating.evidences, editable: cycle.status === 'DRAFT', cycle,
          returnStep: ind.domain, evidenceTypes, canManage: can('school.manage'),
          fileBase: locals.fileBase,
        }) %>
      <% } else if (evidenceRequired) { %>
        <p class="small text-bad"><%= t('assessment_no_evidence') %></p>
      <% } %>
      <% if (cycle.status === 'DRAFT') { %>
      <form method="POST" enctype="multipart/form-data" action="<%= href('/school/cycles/' + (cycle.id) + '/ratings/' + (ind.code) + '/evidence') %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="returnStep" value="<%= ind.domain %>">
        <div class="inline-fields">
          <div>
            <label for="ev-type-<%= ind.code %>"><%= t('evidence_type_label') %></label>
            <select id="ev-type-<%= ind.code %>" name="type">
              <% evidenceTypes.forEach(et => { %><option value="<%= et[0] %>"><%= et[1] %></option><% }) %>
            </select>
          </div>
          <div>
            <label for="ev-source-<%= ind.code %>"><%= t('evidence_source_label') %></label>
            <input type="text" id="ev-source-<%= ind.code %>" name="source" placeholder="<%= t('evidence_source_placeholder') %>">
          </div>
        </div>
        <label for="ev-file-<%= ind.code %>"><%= t('evidence_file_label') %></label>
        <input type="file" id="ev-file-<%= ind.code %>" name="file" accept="<%= locals.evidenceAccept || '' %>">
        <p class="help"><%= t('evidence_file_help') %></p>
        <label for="ev-desc-<%= ind.code %>"><%= t('evidence_description_label') %></label>
        <textarea id="ev-desc-<%= ind.code %>" name="description" required placeholder="<%= t('evidence_description_placeholder') %>"></textarea>
        <div style="margin-top:0.5rem;">
          <button class="btn btn-sm btn-secondary" type="submit">
            <%= t('assessment_add_evidence') %><span class="visually-hidden"> — <%= ind.code %></span>
          </button>
        </div>
      </form>
      <% } %>
    </div>
  <% } %>
</section>
