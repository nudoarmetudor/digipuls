<%
/* One indicator: the level picker, its comment box, and (from level 2 up) the
   evidence sub-form. Every control gets a real id/for pair — ids are prefixed
   with the indicator code because 19 of these render on one page and duplicate
   ids would send every label to the first block. */
const evidenceTypes = [
  ['document', t('ev_document')],
  ['observation_log', t('ev_observation_log')],
  ['survey', t('ev_survey')],
  ['usage_data', t('ev_usage_data')],
  ['it_audit', t('ev_it_audit')],
  ['photo', t('ev_photo')],
  ['minutes', t('ev_minutes')],
  ['certification', t('ev_certification')],
  ['external_validation', t('ev_external_validation')],
];
%>
<section class="indicator-block" id="ind-<%= ind.code %>" aria-labelledby="ind-<%= ind.code %>-h">
  <h3 id="ind-<%= ind.code %>-h"><%= ind.code %>. <%= ind.name %></h3>
  <p class="small"><%= ind.description %></p>

  <% if (ind.priorRating) { %>
    <p class="small">
      <%= t('previous_cycle') %>
      <span class="badge badge-level<%= ind.priorRating.level %>"><%= t('level_label') %> <%= ind.priorRating.level %></span>
      <% if (ind.rating && ind.rating.changeState) { %>
        <span aria-hidden="true">→</span> <%= t('assessment_now') %>
        <span class="badge badge-level<%= ind.rating.level %>"><%= t('level_label') %> <%= ind.rating.level %></span>
        <span class="badge badge-<%= ind.rating.changeState.toLowerCase() %>"><%= CHANGE_STATE_LABELS[ind.rating.changeState] %></span>
      <% } %>
    </p>
  <% } %>

  <form method="POST" action="/school/cycles/<%= cycle.id %>/ratings/<%= ind.code %>">
    <input type="hidden" name="returnStep" value="<%= ind.domain %>">
    <fieldset style="border:none;padding:0;margin:0;">
      <legend class="visually-hidden"><%= t('level_options_label') %> — <%= ind.code %></legend>
      <div class="level-picker">
        <% ind.levels.forEach(lv => { %>
          <label class="level-option<%= ind.rating && ind.rating.level === lv.level ? ' selected' : '' %>">
            <input type="radio" name="level" value="<%= lv.level %>" class="visually-hidden"
              <%= ind.rating && ind.rating.level === lv.level ? 'checked' : '' %>
              data-desc="<%= lv.description %>"
              onclick="this.closest('form').querySelectorAll('.level-option').forEach(el=>el.classList.remove('selected')); this.closest('label').classList.add('selected'); this.closest('form').querySelector('.level-desc-target').innerText = this.dataset.desc;">
            <span class="lv-num"><%= lv.level %></span> — <%= lv.levelName %>
          </label>
        <% }) %>
      </div>
    </fieldset>
    <div class="level-desc">
      <span class="level-desc-target" role="status" aria-live="polite"><%= ind.rating && ind.rating.level !== null ? ind.levels[ind.rating.level].description : t('assessment_select_level') %></span>
    </div>
    <label for="comment-<%= ind.code %>"><%= t('assessment_comment_label') %></label>
    <textarea id="comment-<%= ind.code %>" name="comment"><%= ind.rating ? (ind.rating.comment || '') : '' %></textarea>
    <div style="margin-top:0.6rem;">
      <button class="btn btn-sm" type="submit">
        <%= t('assessment_save_rating') %><span class="visually-hidden"> — <%= ind.code %></span>
      </button>
    </div>
  </form>

  <% if (ind.rating && ind.rating.level >= 2) { %>
    <div class="evidence-block">
      <h4 style="font-size:0.95rem;margin:0 0 0.4rem;">
        <%= t('assessment_evidence_required') %> <span class="small"><%= t('assessment_evidence_required_note') %></span>
      </h4>
      <% if (ind.rating.evidences && ind.rating.evidences.length) { %>
        <ul class="small">
          <% ind.rating.evidences.forEach(ev => { %>
            <li><b><%= t('ev_' + ev.type) %></b>: <%= ev.description %><% if (ev.source) { %> — <i><%= ev.source %></i><% } %></li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="small text-bad"><%= t('assessment_no_evidence') %></p>
      <% } %>
      <form method="POST" action="/school/cycles/<%= cycle.id %>/ratings/<%= ind.code %>/evidence">
        <input type="hidden" name="returnStep" value="<%= ind.domain %>">
        <div class="inline-fields">
          <div>
            <label for="ev-type-<%= ind.code %>"><%= t('evidence_type_label') %></label>
            <select id="ev-type-<%= ind.code %>" name="type">
              <% evidenceTypes.forEach(et => { %><option value="<%= et[0] %>"><%= et[1] %></option><% }) %>
            </select>
          </div>
          <div>
            <label for="ev-source-<%= ind.code %>"><%= t('evidence_source_label') %></label>
            <input type="text" id="ev-source-<%= ind.code %>" name="source" placeholder="<%= t('evidence_source_placeholder') %>">
          </div>
        </div>
        <label for="ev-desc-<%= ind.code %>"><%= t('evidence_description_label') %></label>
        <textarea id="ev-desc-<%= ind.code %>" name="description" required placeholder="<%= t('evidence_description_placeholder') %>"></textarea>
        <div style="margin-top:0.5rem;">
          <button class="btn btn-sm btn-secondary" type="submit">
            <%= t('assessment_add_evidence') %><span class="visually-hidden"> — <%= ind.code %></span>
          </button>
        </div>
      </form>
    </div>
  <% } %>
</section>
