<h1><%= school.name %> — <%= t('cycle') %> <%= cycle.cycleNumber %></h1>
<%- include('_step-nav', { activeStep: 'review' }) %>

<div class="card card-centre">
  <figure>
    <h2 class="plain-heading"><%= t('wheel_title') %></h2>
    <%- wheelSvg %>
    <figcaption><%= t('wheel_caption') %></figcaption>
  </figure>
</div>

<div class="card">
  <h2 class="plain-heading" id="review-summary"><%= t('summary_all_indicators') %></h2>
  <div class="table-scroll">
    <table aria-labelledby="review-summary">
      <thead>
        <tr>
          <th scope="col"><%= t('domain_label') %></th>
          <th scope="col"><%= t('th_indicator') %></th>
          <th scope="col"><%= t('level_label') %></th>
          <th scope="col"><span class="visually-hidden"><%= t('details') %></span></th>
        </tr>
      </thead>
      <tbody>
        <% domains.forEach(d => { %>
          <% d.indicators.forEach(ind => { %>
            <tr>
              <td><%= d.code %></td>
              <th scope="row" style="background:none;font-weight:400;color:inherit;"><%= ind.code %> — <%= ind.name %></th>
              <td>
                <% if (ind.rating && ind.rating.level !== null) { %>
                  <span class="badge badge-level<%= ind.rating.level %>"><%= t('level_label') %> <%= ind.rating.level %></span>
                <% } else { %><span class="badge">—</span><% } %>
              </td>
              <td>
                <% if (ind.rating && ind.rating.level >= 2 && (!ind.rating.evidences || ind.rating.evidences.length === 0)) { %>
                  <span class="small text-bad"><%= t('evidence_missing') %></span>
                <% } %>
                <a class="plain small" href="/school/cycles/<%= cycle.id %>/step/<%= d.code %>#ind-<%= ind.code %>">
                  <%= t('edit') %><span class="visually-hidden"> <%= ind.code %></span>
                </a>
              </td>
            </tr>
          <% }) %>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<% if (errorMessage) { %><div class="flash flash-error" role="alert"><%= errorMessage %></div><% } %>

<% if (cycle.status === 'DRAFT') { %>
  <div class="card">
    <h2 class="plain-heading"><%= t('assessment_confirm_title') %></h2>
    <p class="small"><%= t('assessment_confirm_body') %></p>
    <form method="POST" action="/school/cycles/<%= cycle.id %>/confirm">
      <button class="btn" type="submit"><%= t('assessment_confirm_button') %></button>
    </form>
  </div>
<% } else { %>
  <div class="card card-ok">
    <p>
      <span class="badge badge-confirmed"><%= STATUS_LABELS.CONFIRMED %></span>
      <%= t('school_confirmed_on') %> <%= new Date(cycle.confirmedAt).toLocaleDateString(lang) %>.
    </p>
    <a class="btn btn-secondary" href="/school/cycles/<%= cycle.id %>/plan"><%= t('school_view_plan') %></a>
  </div>
<% } %>

<div class="card card-centre">
  <a class="btn btn-secondary" href="/school/cycles/<%= cycle.id %>"><span aria-hidden="true">←</span> <%= t('back_to_overview') %></a>
</div>
