<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Digital Development Plan — <%= school.name %></title>
<link rel="stylesheet" href="/static/css/style.css">
<style>
  body { background: white; }
  .container { max-width: 800px; }
  @media print { .no-print { display: none; } }
</style>
</head>
<body>
<div class="container">
  <div class="no-print" style="margin-bottom:1rem;"><button class="btn btn-sm" onclick="window.print()">Print / Save as PDF</button></div>
  <h1>Digital Development Plan</h1>
  <h2 style="border:none;"><%= school.name %></h2>
  <p class="small">Cycle <%= cycle.cycleNumber %> · Published <%= plan.publishedAt ? new Date(plan.publishedAt).toLocaleDateString() : '(not yet published)' %> · 2-year plan</p>

  <h2>Priorities</h2>
  <% plan.priorities.forEach(p => { %>
    <div class="card">
      <h3><%= p.indicatorCode %> — <%= p.indicator.name %></h3>
      <p><b>Current level:</b> <%= p.currentLevel %> → <b>Target level:</b> <%= p.targetLevel %></p>
      <p><b>Rationale:</b> <%= p.rationale %></p>
      <p><b>Actions:</b> <%= p.actions %></p>
      <p><b>Responsible:</b> <%= p.responsible || '—' %> &nbsp; <b>Timeline:</b> <%= p.timeline || '—' %></p>
    </div>
  <% }) %>

  <h2>Funding &amp; approval</h2>
  <p><b>Funding source:</b> <%= plan.fundingSource || '—' %></p>
  <p><b>Approving authority:</b> <%= plan.approvingAuthority || '—' %></p>

  <h2>Stakeholder consultation</h2>
  <p><%= plan.stakeholderConsultationNotes || '—' %></p>

  <p class="small" style="margin-top:2rem;">Generated by DigiPuls. This is a browser print-to-PDF export for the MVP; a server-side PDF renderer is a natural next step (see README.md, "Not yet built").</p>
</div>
</body>
</html>
