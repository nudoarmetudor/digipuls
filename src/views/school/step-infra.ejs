<h1><%= school.name %> — <%= lang==='ro'?'Ciclul':'Cycle' %> <%= cycle.cycleNumber %></h1>
<%- include('_step-nav', { activeStep: 'infra' }) %>

<% if (errorMessage) { %><div class="flash flash-error"><%= errorMessage %></div><% } %>

<div class="card">
  <h3><%= t('order675_data_title') %></h3>
  <p class="small"><%= t('order675_data_caption') %></p>
  <p class="small" style="color:var(--grey);"><%= t('order675_scope_note') %></p>
  <div class="grid-2">
    <div>
      <h3 style="font-size:0.9rem;"><%= t('device_inventory') %></h3>
      <form method="POST" action="/school/cycles/<%= cycle.id %>/device">
        <div class="grid-2">
          <div><label><%= lang==='ro'?'PC-uri/laptopuri clase':'Classroom PCs/laptops' %></label><input type="number" name="classroomPCs" value="<%= cycle.deviceInventory ? cycle.deviceInventory.classroomPCs : 0 %>"></div>
          <div><label><%= lang==='ro'?'Panouri interactive':'Interactive panels' %></label><input type="number" name="interactivePanels" value="<%= cycle.deviceInventory ? cycle.deviceInventory.interactivePanels : 0 %>"></div>
          <div><label><%= lang==='ro'?'PC-uri sala IT':'IT-room PCs' %></label><input type="number" name="itRoomPCs" value="<%= cycle.deviceInventory ? cycle.deviceInventory.itRoomPCs : 0 %>"></div>
          <div><label><%= lang==='ro'?'PC-uri conducere':'Management PCs' %></label><input type="number" name="managementPCs" value="<%= cycle.deviceInventory ? cycle.deviceInventory.managementPCs : 0 %>"></div>
          <div><label><%= lang==='ro'?'PC-uri centru metodic':'Methodical-centre PCs' %></label><input type="number" name="methodicalCentrePCs" value="<%= cycle.deviceInventory ? cycle.deviceInventory.methodicalCentrePCs : 0 %>"></div>
          <div><label><%= lang==='ro'?'PC-uri bibliotecă':'Library PCs' %></label><input type="number" name="libraryPCs" value="<%= cycle.deviceInventory ? cycle.deviceInventory.libraryPCs : 0 %>"></div>
          <div><label><%= lang==='ro'?'Imprimante':'Printers' %></label><input type="number" name="printers" value="<%= cycle.deviceInventory ? cycle.deviceInventory.printers : 0 %>"></div>
          <div><label><%= lang==='ro'?'Imprimante multifuncționale':'Multifunction printers' %></label><input type="number" name="multifunctionPrinters" value="<%= cycle.deviceInventory ? cycle.deviceInventory.multifunctionPrinters : 0 %>"></div>
        </div>
        <div style="margin-top:0.6rem;"><button class="btn btn-sm" type="submit"><%= t('save_inventory') %></button></div>
      </form>
    </div>
    <div>
      <h3 style="font-size:0.9rem;"><%= t('network_checklist') %></h3>
      <form method="POST" action="/school/cycles/<%= cycle.id %>/network">
        <% const nc = cycle.networkChecklist || {}; %>
        <label><input type="checkbox" name="wifiWholeSchool" <%= nc.wifiWholeSchool ? 'checked' : '' %> style="width:auto;display:inline"> <%= lang==='ro'?'Acoperire WiFi/LAN în toată școala':'Whole-school WiFi/LAN coverage' %></label>
        <label><input type="checkbox" name="subnetsSeparated" <%= nc.subnetsSeparated ? 'checked' : '' %> style="width:auto;display:inline"> <%= lang==='ro'?'Subrețele separate (admin/elevi/oaspeți)':'Separated subnets (admin/students/guest)' %></label>
        <label><input type="checkbox" name="wifi80211n" <%= nc.wifi80211n ? 'checked' : '' %> style="width:auto;display:inline"> <%= lang==='ro'?'Standard 802.11n':'802.11n standard' %></label>
        <label><input type="checkbox" name="wifi80211ac" <%= nc.wifi80211ac ? 'checked' : '' %> style="width:auto;display:inline"> <%= lang==='ro'?'Standard 802.11ac':'802.11ac standard' %></label>
        <label><input type="checkbox" name="firewallActive" <%= nc.firewallActive ? 'checked' : '' %> style="width:auto;display:inline"> <%= lang==='ro'?'Firewall activ':'Active firewall' %></label>
        <label><input type="checkbox" name="contentFiltering" <%= nc.contentFiltering ? 'checked' : '' %> style="width:auto;display:inline"> <%= lang==='ro'?'Filtrare de conținut':'Content filtering' %></label>
        <div style="margin-top:0.6rem;"><button class="btn btn-sm" type="submit"><%= t('save_checklist') %></button></div>
      </form>
    </div>
  </div>

  <% if (deviceCompliance) { %>
    <h3 style="margin-top:1.2rem;">D2 — <%= lang==='ro'?'verificare cantitativă echipamente, Ordinul 675':'Order 675 quantitative equipment check' %> (<%= lang==='ro'?'bandă':'band' %> <%= deviceCompliance.band %>)
      <span class="badge badge-<%= deviceCompliance.compliant ? 'pass' : 'fail' %>"><%= deviceCompliance.compliant ? t('compliant') : t('non_compliant') %></span>
    </h3>
    <table>
      <tr><th><%= t('requirement') %></th><th><%= t('required') %></th><th><%= t('actual') %></th><th></th></tr>
      <% deviceCompliance.checks.forEach(c => { %>
        <tr><td><%= c.label %></td><td><%= c.required %></td><td><%= c.actual %></td><td><span class="badge badge-<%= c.pass ? 'pass' : 'fail' %>"><%= c.pass ? t('ok') : t('short') %></span></td></tr>
      <% }) %>
    </table>
  <% } %>
  <% if (networkCompliance) { %>
    <h3 style="margin-top:1.2rem;">D1 — <%= lang==='ro'?'listă de verificare rețea, Ordinul 675':'Order 675 network checklist' %>
      <span class="badge badge-<%= networkCompliance.compliant ? 'pass' : 'fail' %>"><%= networkCompliance.compliant ? t('compliant') : t('non_compliant') %></span>
    </h3>
    <table>
      <tr><th><%= t('requirement') %></th><th></th></tr>
      <% networkCompliance.checks.forEach(c => { %>
        <tr><td><%= c.label %></td><td><span class="badge badge-<%= c.pass ? 'pass' : 'fail' %>"><%= c.pass ? t('ok') : t('missing') %></span></td></tr>
      <% }) %>
    </table>
    <p class="small"><b><%= lang==='ro'?'Notă:':'Note:' %></b> <%= t('compliance_note') %></p>
  <% } %>
</div>

<div class="card" style="text-align:center;">
  <a class="btn btn-secondary" href="/school/cycles/<%= cycle.id %>"><%= lang==='ro'?'← Înapoi la prezentare generală':'← Back to overview' %></a>
</div>
