<%
const deviceFields = ['classroomPCs', 'interactivePanels', 'itRoomPCs', 'managementPCs',
  'methodicalCentrePCs', 'libraryPCs', 'printers', 'multifunctionPrinters'];
const networkFields = ['wifiWholeSchool', 'subnetsSeparated', 'wifi80211n',
  'wifi80211ac', 'firewallActive', 'contentFiltering'];
const inv = cycle.deviceInventory || {};
const nc = cycle.networkChecklist || {};
%>
<h1><%= school.name %> — <%= t('cycle') %> <%= cycle.cycleNumber %></h1>
<%- include('_step-nav', { activeStep: 'infra' }) %>

<% if (errorMessage) { %><div class="flash flash-error" role="alert"><%= errorMessage %></div><% } %>

<div class="card">
  <h2 class="plain-heading"><%= t('order675_data_title') %></h2>
  <p class="small"><%= t('order675_data_caption') %></p>
  <p class="small"><%= t('order675_scope_note') %></p>

  <div class="grid-2">
    <section aria-labelledby="inv-h">
      <h3 id="inv-h" style="font-size:0.95rem;"><%= t('device_inventory') %></h3>
      <form method="POST" action="/school/cycles/<%= cycle.id %>/device">
        <div class="grid-2">
          <% deviceFields.forEach(f => { %>
            <div>
              <label for="dev-<%= f %>"><%= t('dev_' + f) %></label>
              <input type="number" id="dev-<%= f %>" name="<%= f %>" min="0" step="1" value="<%= inv[f] || 0 %>">
            </div>
          <% }) %>
        </div>
        <div style="margin-top:0.6rem;"><button class="btn btn-sm" type="submit"><%= t('save_inventory') %></button></div>
      </form>
    </section>

    <section aria-labelledby="net-h">
      <h3 id="net-h" style="font-size:0.95rem;"><%= t('network_checklist') %></h3>
      <form method="POST" action="/school/cycles/<%= cycle.id %>/network">
        <% networkFields.forEach(f => { %>
          <label class="checkbox" for="net-<%= f %>">
            <input type="checkbox" id="net-<%= f %>" name="<%= f %>" <%= nc[f] ? 'checked' : '' %>>
            <span><%= t('net_' + f) %></span>
          </label>
        <% }) %>
        <div style="margin-top:0.6rem;"><button class="btn btn-sm" type="submit"><%= t('save_checklist') %></button></div>
      </form>
    </section>
  </div>

  <% if (deviceCompliance) { %>
    <h3 id="d2-h" style="margin-top:1.4rem;">
      D2 — <%= t('d2_heading') %> (<%= t('band') %> <%= deviceCompliance.band %>)
      <span class="badge badge-<%= deviceCompliance.compliant ? 'pass' : 'fail' %>"><%= deviceCompliance.compliant ? t('compliant') : t('non_compliant') %></span>
    </h3>
    <div class="table-scroll">
      <table aria-labelledby="d2-h">
        <thead>
          <tr>
            <th scope="col"><%= t('requirement') %></th>
            <th scope="col"><%= t('required') %></th>
            <th scope="col"><%= t('actual') %></th>
            <th scope="col"><%= t('th_status') %></th>
          </tr>
        </thead>
        <tbody>
          <% deviceCompliance.checks.forEach(c => { %>
            <tr>
              <th scope="row" style="background:none;font-weight:400;color:inherit;"><%= t(c.labelKey, c.labelParams) %></th>
              <td><%= c.required %></td>
              <td><%= c.actual %></td>
              <td><span class="badge badge-<%= c.pass ? 'pass' : 'fail' %>"><%= c.pass ? t('ok') : t('short') %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

  <% if (networkCompliance) { %>
    <h3 id="d1-h" style="margin-top:1.4rem;">
      D1 — <%= t('d1_heading') %>
      <span class="badge badge-<%= networkCompliance.compliant ? 'pass' : 'fail' %>"><%= networkCompliance.compliant ? t('compliant') : t('non_compliant') %></span>
    </h3>
    <div class="table-scroll">
      <table aria-labelledby="d1-h">
        <thead>
          <tr><th scope="col"><%= t('requirement') %></th><th scope="col"><%= t('th_status') %></th></tr>
        </thead>
        <tbody>
          <% networkCompliance.checks.forEach(c => { %>
            <tr>
              <th scope="row" style="background:none;font-weight:400;color:inherit;"><%= t(c.labelKey) %></th>
              <td><span class="badge badge-<%= c.pass ? 'pass' : 'fail' %>"><%= c.pass ? t('ok') : t('missing') %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <p class="small"><b><%= t('note') %>:</b> <%= t('compliance_note') %></p>
  <% } %>
</div>

<div class="card card-centre">
  <a class="btn btn-secondary" href="/school/cycles/<%= cycle.id %>"><span aria-hidden="true">←</span> <%= t('back_to_overview') %></a>
</div>
