// DigiPuls — Prisma schema
// Runs on MySQL (Hostinger's included database service — see DEPLOYMENT.md).
// Originally prototyped against SQLite for local dev; moved to MySQL after
// discovering SQLite's file-locking doesn't work reliably on this host's
// storage (DB-touching requests hung indefinitely rather than erroring).
// Free-text fields below are explicitly @db.Text since MySQL's default
// String mapping is VARCHAR(191), too short for real assessment prose.

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// driverAdapters routes queries through a pure-JS MySQL driver instead of
// Prisma's Rust query engine. Required here, not optional: the production
// host is CloudLinux shared hosting, whose LVE process/thread limits kill
// the Rust engine's Tokio worker threads mid-query, producing intermittent
// "PANIC: timer has gone away" crashes. See DEPLOYMENT.md.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// ---------------------------------------------------------------------------
// Identity & organisation
// ---------------------------------------------------------------------------

model Territory {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  schools     School[]
  users       User[]
  assignments Assignment[]
}

model User {
  id                 Int        @id @default(autoincrement())
  // The login identifier, not an address. The pilot's meta-mentors have no
  // institutional mailbox — there is no @digipuls.md mail domain — so an
  // email field would have been a form that asks for something nobody has.
  // Accounts are identified by a handle like "gurita.elena"; the seeded demo
  // accounts happen to look like addresses, which is fine because nothing
  // here treats the value as one. Renamed from `email` by migration, so the
  // existing values were preserved.
  login              String     @unique
  passwordHash       String
  name               String
  // See ROLES in src/services/capabilities.js — the school positions, the
  // meta-mentor line, the oversight readers, and the platform administrator.
  role               String
  schoolId           Int?
  school             School?    @relation(fields: [schoolId], references: [id])
  territoryId        Int?
  territory          Territory? @relation(fields: [territoryId], references: [id])
  createdAt          DateTime   @default(now())
  // Forces a password-change screen before anything else is reachable —
  // set true whenever an account is provisioned with a system-generated
  // one-time password (see admin.js), never true for the demo seed logins.
  mustChangePassword Boolean    @default(false)

  // Deactivation rather than deletion is the default way to remove someone's
  // access: a user is referenced by audit entries and by the cycles they
  // confirmed, and those references are the record of who did what. Blanking
  // them to delete a row would damage the audit trail this system exists to
  // keep. Checked on every request, not just at login, so revoking access
  // takes effect immediately instead of at the person's next sign-in.
  isActive Boolean @default(true)

  auditEntries           AuditLogEntry[]
  confirmedCycles        AssessmentCycle[] @relation("CycleConfirmedBy")
  publishedCycles        AssessmentCycle[] @relation("CyclePublishedBy")
  publishedReports       PlanReport[]      @relation("ReportPublishedBy")
  initiativesResponsible PlanInitiative[]  @relation("InitiativeResponsible")
  initiativesSupervised  PlanInitiative[]  @relation("InitiativeSupervisor")
  capabilities           UserCapability[]
  assignments            Assignment[]
  feedbackTickets        FeedbackTicket[]  @relation("TicketAuthor")
  triagedTickets         FeedbackTicket[]  @relation("TicketTriager")
}

// One post a person holds: a role, at one institution.
//
// A person is not a role. Elena is a meta-mentor for one lyceum and the
// DigiPuls coordinator for another, from the same account — so the role and
// the institution belong on the assignment, not on the user. `role`,
// `schoolId` and `territoryId` remain on User for now, backfilled into a
// first assignment by the migration and no longer read by application code;
// they are dropped in a later release once this model has run in production
// (expand/contract — see ROADMAP.md).
//
// Which assignment is *active* is carried in the URL (/w/<id>/...), not in
// the session, so two browser tabs can sit in two different roles at once.
// See src/middleware/workspace.js.
model Assignment {
  id          Int        @id @default(autoincrement())
  userId      Int
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String
  schoolId    Int?
  school      School?    @relation(fields: [schoolId], references: [id])
  territoryId Int?
  territory   Territory? @relation(fields: [territoryId], references: [id])
  // Free text for what this post is called locally ("Coordonator DigiPuls"),
  // shown in the switcher next to the role. Purely descriptive.
  label       String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())

  capabilities AssignmentCapability[]

  // The same role at the same institution twice is not a second post, it is
  // a duplicate. MySQL treats NULLs as distinct in a unique index, so this
  // constrains the school/territory-scoped rows; the unscoped ones (Ministry,
  // Admin) are guarded in routes/adminUsers.js instead.
  @@unique([userId, role, schoolId, territoryId])
  @@index([userId])
}

// Per-assignment override of what the assignment's role grants by default —
// the same algebra as UserCapability, moved down a level now that permissions
// belong to a post rather than to a person. Elena's mentor capabilities have
// nothing to do with her coordinator ones.
model AssignmentCapability {
  id           Int        @id @default(autoincrement())
  assignmentId Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  capability   String
  granted      Boolean

  @@unique([assignmentId, capability])
}

// Per-user override of what the account's role grants by default.
// `granted = true` adds a capability the role doesn't include; `false`
// removes one it does. Only differences from the role default are stored, so
// a role's defaults can be changed later without having to rewrite every
// user's row — see src/services/capabilities.js.
model UserCapability {
  id         Int     @id @default(autoincrement())
  userId     Int
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  capability String
  granted    Boolean

  @@unique([userId, capability])
}

// A school is provisioned either from the SIME registry (see services/sime)
// or manually for the pilot cohort. simeId is nullable because not every
// pilot-cohort school will necessarily have been matched to a SIME record
// yet — see the SIME integration note in README.md.
model School {
  id                    Int        @id @default(autoincrement())
  name                  String
  simeId                String?    @unique
  territoryId           Int?
  territory             Territory? @relation(fields: [territoryId], references: [id])
  address               String?
  enrolmentTotal        Int        @default(0)
  studentsGrades7to12   Int        @default(0)
  classroomsTotal       Int        @default(0)
  // computed at read-time from enrolmentTotal via src/services/order675.js;
  // stored too for simple querying/filtering in dashboards
  enrolmentBand         String     @default("0-250")
  publicDisclosureOptIn Boolean    @default(false)
  createdAt             DateTime   @default(now())

  users       User[]
  assignments Assignment[]
  cycles      AssessmentCycle[]
}

// ---------------------------------------------------------------------------
// Reference data: the 19-indicator, 6-level instrument (Annex A)
// Seeded once from src/data/indicators.js — this is fixed reference content,
// not something schools edit.
// ---------------------------------------------------------------------------

model Indicator {
  code        String @id // e.g. "A1", "B5", "D2"
  domain      String // "A" | "B" | "C" | "D"
  name        String
  description String @db.Text
  sortOrder   Int

  levels     IndicatorLevel[]
  ratings    IndicatorRating[]
  priorities PlanPriority[]
}

model IndicatorLevel {
  id                  Int       @id @default(autoincrement())
  indicatorCode       String
  indicator           Indicator @relation(fields: [indicatorCode], references: [code])
  level               Int // 0-5
  levelName           String // "Below floor" | "Accidental" | ... | "Continuous innovation"
  description         String    @db.Text
  engagementBenchmark String?   @db.Text
  frequencyBenchmark  String?   @db.Text
  evidenceBenchmark   String?   @db.Text

  @@unique([indicatorCode, level])
}

// ---------------------------------------------------------------------------
// Assessment cycles (2-year, continuation model — see Process 2)
// ---------------------------------------------------------------------------

model AssessmentCycle {
  id              Int              @id @default(autoincrement())
  schoolId        Int
  school          School           @relation(fields: [schoolId], references: [id])
  cycleNumber     Int // 1, 2, 3... per school
  startedAt       DateTime         @default(now())
  confirmedAt     DateTime?
  confirmedById   Int?
  confirmedBy     User?            @relation("CycleConfirmedBy", fields: [confirmedById], references: [id])
  // DRAFT | CONFIRMED — once CONFIRMED, ratings/evidence/device/network
  // become immutable (enforced in routes/school.js, not just the UI); the
  // only way to change anything further is to start a continuation cycle.
  status          String           @default("DRAFT")
  previousCycleId Int?             @unique
  previousCycle   AssessmentCycle? @relation("CycleContinuation", fields: [previousCycleId], references: [id])
  nextCycle       AssessmentCycle? @relation("CycleContinuation")

  // Publishing is a separate act from confirming. Confirming settles what the
  // school found; publishing decides that the public may read it. The Ministry,
  // the partners and the metamentor see a confirmed assessment either way —
  // this gate is only on the public tier.
  publishedAt   DateTime?
  publishedById Int?
  publishedBy   User?     @relation("CyclePublishedBy", fields: [publishedById], references: [id])

  ratings          IndicatorRating[]
  plan             DevelopmentPlan?
  deviceInventory  DeviceInventory?
  networkChecklist NetworkChecklist?

  @@unique([schoolId, cycleNumber])
}

// Order 675 Annex 2 numeric device counts — feeds the D2 compliance check.
model DeviceInventory {
  id                    Int             @id @default(autoincrement())
  cycleId               Int             @unique
  cycle                 AssessmentCycle @relation(fields: [cycleId], references: [id])
  classroomPCs          Int             @default(0)
  interactivePanels     Int             @default(0)
  itRoomPCs             Int             @default(0)
  managementPCs         Int             @default(0)
  methodicalCentrePCs   Int             @default(0)
  libraryPCs            Int             @default(0)
  printers              Int             @default(0)
  multifunctionPrinters Int             @default(0)
}

// Order 675 Annex 5 network/security checklist — feeds the D1 compliance check.
model NetworkChecklist {
  id               Int             @id @default(autoincrement())
  cycleId          Int             @unique
  cycle            AssessmentCycle @relation(fields: [cycleId], references: [id])
  wifiWholeSchool  Boolean         @default(false)
  subnetsSeparated Boolean         @default(false)
  wifi80211n       Boolean         @default(false)
  wifi80211ac      Boolean         @default(false)
  firewallActive   Boolean         @default(false)
  contentFiltering Boolean         @default(false)
}

model IndicatorRating {
  id            Int             @id @default(autoincrement())
  cycleId       Int
  cycle         AssessmentCycle @relation(fields: [cycleId], references: [id])
  indicatorCode String
  indicator     Indicator       @relation(fields: [indicatorCode], references: [code])
  // ADMINISTRATION | TEAM | AGREED.
  //
  // The school's administration and its team rate every parameter
  // independently and neither sees the other while doing it; the principal
  // then records what the two sides settled on. The agreed value is a third
  // reading, not a copy of either — the point of discussing a gap is that the
  // answer can be neither number.
  //
  // AGREED is the official record: it is what the wheel, the dashboards, the
  // exports and the public pages read, and what confirmation checks. Defaulted
  // so that anything written by code unaware of tracks lands on the official
  // record rather than in a working draft.
  track         String          @default("AGREED")
  // 0-5, or null if not yet rated in this cycle (a first-cycle draft starts
  // every indicator as an unrated placeholder row, not a missing row — see
  // cycleService.startFirstCycle).
  level         Int?
  // MAINTAINED | GREW | DECAYED | null (first cycle, no prior state to compare)
  changeState   String?
  comment       String?         @db.Text // Digipeegel-style justification/exception field (UC-S3)
  updatedAt     DateTime        @updatedAt

  evidences Evidence[]

  @@unique([cycleId, indicatorCode, track])
}

model Evidence {
  id          Int             @id @default(autoincrement())
  ratingId    Int
  rating      IndicatorRating @relation(fields: [ratingId], references: [id])
  type        String // document | observation_log | survey | usage_data | it_audit | photo | minutes | certification | external_validation
  description String          @db.Text
  source      String?
  filePath    String?
  createdAt   DateTime        @default(now())
  // set true once a peer/meta-mentor validation record exists for this
  // indicator/cycle — this is the flag the donation-matching eligibility
  // gate (Process 5, step 3) checks. See ValidationRecord below.
}

model ValidationRecord {
  id              Int      @id @default(autoincrement())
  cycleId         Int
  reviewerName    String
  reviewerType    String // peer_school | meta_mentor | external_evaluator
  indicatorCode   String? // null = validates the whole cycle
  verdict         String // agree | disagree
  reliabilityNote String? // broadly_reliable | optimistic | conservative
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Digital development plan (Annex C)
// ---------------------------------------------------------------------------

model DevelopmentPlan {
  id                           Int             @id @default(autoincrement())
  cycleId                      Int             @unique
  cycle                        AssessmentCycle @relation(fields: [cycleId], references: [id])
  publishedAt                  DateTime?
  fundingSource                String?
  approvingAuthority           String?
  stakeholderConsultationNotes String?         @db.Text

  // A DigiPlan runs two years, with a report at the halfway point. The dates
  // bound every initiative underneath it: a deadline outside the plan's own
  // life is a plan for somebody else's cycle.
  startsOn DateTime?
  endsOn   DateTime?

  priorities PlanPriority[]
  reports    PlanReport[]
}

// A report on how the plan is going.
//
// The DigiPlan runs two years with a report at the halfway point, and the report
// is built from the initiatives that already exist — their status, and what
// their measures actually reached against the targets the school set. None of
// that is re-entered; the school updates the initiatives as it goes and the
// report reads them.
//
// What it keeps of its own is the narrative, and a snapshot taken when it is
// published. The snapshot matters: implementation continues after the report
// goes out, so a report reading live data would quietly rewrite itself and a
// year-one report would eventually describe year two. Frozen as JSON rather
// than as a second set of tables because nothing queries inside a published
// report — it is read as a document.
model PlanReport {
  id            Int             @id @default(autoincrement())
  planId        Int
  plan          DevelopmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  // INTERIM (after the first year) | FINAL (at the end of the plan)
  kind          String
  narrative     String?         @db.Text
  snapshot      Json?
  publishedAt   DateTime?
  publishedById Int?
  publishedBy   User?           @relation("ReportPublishedBy", fields: [publishedById], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([planId, kind])
}

// One row per parameter per plan — all nineteen, not a shortlist.
//
// A school that advances three parameters is also committing to hold sixteen
// where they are, and holding a level is work with its own requirements. Making
// every parameter a row is what stops "the plan" meaning only the exciting part.
model PlanPriority {
  id            Int             @id @default(autoincrement())
  planId        Int
  plan          DevelopmentPlan @relation(fields: [planId], references: [id])
  indicatorCode String
  indicator     Indicator       @relation(fields: [indicatorCode], references: [code])
  // ADVANCE | MAINTAIN. Maintain is the default, because staying where you are
  // is the commitment a school makes by not choosing otherwise.
  intent        String          @default("MAINTAIN")
  // Where the parameter stood when the plan was opened, copied from the agreed
  // level of the confirmed assessment — so the plan does not shift under the
  // school if a later cycle moves it.
  currentLevel  Int
  // Equal to currentLevel when the intent is MAINTAIN.
  targetLevel   Int
  rationale     String?         @db.Text
  // Legacy free text from the five-priority plan this replaced. Kept so an
  // older plan still renders; nothing writes them now — the work lives in
  // initiatives.
  actions       String?         @db.Text
  responsible   String?
  timeline      String?
  // achieved | partial | dropped | in_progress (set at the START of the
  // *next* cycle, when reviewing this priority's outcome)
  outcomeStatus String?

  initiatives PlanInitiative[]

  @@unique([planId, indicatorCode])
}

// What the school will actually do about one parameter.
//
// The requirements for reaching a level are general by design: they say what
// level 4 means, not what this school must do on Tuesday. Closing that gap is
// the school's own work, and this is where it is written down. A parameter
// carries as many initiatives as it needs; an initiative belongs to exactly one
// parameter.
model PlanInitiative {
  id          Int          @id @default(autoincrement())
  priorityId  Int
  priority    PlanPriority @relation(fields: [priorityId], references: [id], onDelete: Cascade)
  title       String
  description String?      @db.Text

  // Who does it, and who oversees it. Linked to an account where the person has
  // one — a school of fifty teachers has about seven — and otherwise simply
  // written down, because a name without a login is still the answer to "who is
  // responsible".
  responsibleUserId Int?
  responsibleUser   User?   @relation("InitiativeResponsible", fields: [responsibleUserId], references: [id])
  responsibleName   String?
  supervisorUserId  Int?
  supervisorUser    User?   @relation("InitiativeSupervisor", fields: [supervisorUserId], references: [id])
  supervisorName    String?

  startsOn  DateTime?
  dueOn     DateTime?
  // NOT_STARTED | IN_PROGRESS | DONE | DROPPED
  status    String    @default("NOT_STARTED")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  kpis PlanKpi[]

  @@index([priorityId])
}

// How the school will know the initiative worked.
//
// The measure and the target that counts as success, kept apart so the interim
// report can put what actually happened beside what was promised, rather than
// asking a reader to re-read a sentence and decide.
model PlanKpi {
  id           Int            @id @default(autoincrement())
  initiativeId Int
  initiative   PlanInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  measure      String
  target       String
  // Filled in at the interim report, and again at the end of the plan.
  actual       String?

  @@index([initiativeId])
}

// NOTE: an earlier version of this schema had a DonationQuery /
// DonationQueryResult pair implementing an automated donation-matching
// engine (scoring/ranking schools against a partner's offer). Removed by
// explicit design decision: "do not create any automatic match-making
// engine for donations... situations are evaluated on a case by case
// approach." Partners, Ministry and territorial authorities now get a
// filterable/sortable read-only overview instead — see
// services/schoolOverview.js's filterRows/toCsv, not a scoring service.

// ---------------------------------------------------------------------------
// Cross-cutting
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Pilot feedback ("developer backlog")
//
// Meta-mentors test the platform against real school data, and the useful
// half of their feedback is *where* something is wrong, not just that it is.
// The click-to-report overlay (public/js/feedback.js) captures that context
// automatically — the template that rendered the element, a CSS path to it,
// and any i18n keys whose text matches it, which is what actually lets a
// developer find the code. The columns below are that captured context; the
// person only has to write the comment.
// ---------------------------------------------------------------------------

model FeedbackTicket {
  id       Int  @id @default(autoincrement())
  authorId Int
  author   User @relation("TicketAuthor", fields: [authorId], references: [id])

  // OPEN | ACKNOWLEDGED | IN_PROGRESS | FIXED | WONT_FIX | DUPLICATE
  status   String @default("OPEN")
  // BLOCKER | MAJOR | NORMAL | MINOR | IDEA
  severity String @default("NORMAL")
  comment  String @db.Text

  // --- captured automatically by the overlay ---
  route          String
  // The EJS template that rendered the page, captured by wrapping res.render
  // in app.js so no route has to remember to pass it.
  viewName       String?
  selector       String? @db.Text
  elementSummary String? @db.Text
  elementText    String? @db.Text
  // Comma-separated i18n keys whose text matches what was clicked. These are
  // directly greppable, and are usually the fastest route from "this label is
  // wrong" to the line that produces it.
  i18nKeys       String? @db.Text
  lang           String?
  displayPrefs   String?
  viewport       String?
  userAgent      String? @db.Text

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  triagedById   Int?
  triagedBy     User?   @relation("TicketTriager", fields: [triagedById], references: [id])
  developerNote String? @db.Text

  @@index([status])
  @@index([authorId])
}

model AuditLogEntry {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  details    String?  @db.Text
  createdAt  DateTime @default(now())
}
