{
  "name": "digipuls",
  "version": "0.1.0",
  "description": "DigiPuls — Moldova Digital School Framework (MDSF) self-assessment, planning, and multi-stakeholder status platform. MVP prototype.",
  "main": "src/app.js",
  "scripts": {
    "dev": "node src/app.js",
    "start": "node src/app.js",
    "build": "prisma generate && prisma migrate deploy",
    "postinstall": "prisma generate",
    "test": "node --test tests/*.test.js",
    "migrate": "prisma migrate dev",
    "seed": "node prisma/seed.js",
    "setup": "npm install && npx prisma migrate dev --name init && npm run seed",
    "studio": "prisma studio"
  },
  "keywords": [
    "digipuls",
    "mdsf",
    "moldova",
    "education"
  ],
  "author": "",
  "license": "GPL-3.0",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-mariadb": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.19.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "prisma": "^6.19.3"
  }
}
