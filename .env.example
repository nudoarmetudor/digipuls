# MySQL — see DEPLOYMENT.md. For local dev, point this at a local MySQL
# (e.g. `docker run -p 3306:3306 -e MYSQL_ROOT_PASSWORD=devpass -e MYSQL_DATABASE=digipuls mysql:8`)
# or a dev database your host provides; SQLite was tried first for local
# dev but dropped after its file-locking hung on production hosting.
DATABASE_URL="mysql://root:devpass@localhost:3306/digipuls"
# Must be a long random value in production; the app refuses to start without
# one there rather than falling back to a dev secret that is published in this
# repository.
SESSION_SECRET="change-me"

# The database sits on a different host from the app in production, so the
# connection is TLS-encrypted with certificate verification by default.
# Set DB_SSL=false only for a local container with no certificate.
# DB_SSL_INSECURE=true still encrypts but skips verification.
# DB_SSL=false
PORT=3000
SIME_PROVIDER="mock"
NODE_ENV=development
# Shows the demo-accounts panel on the login page and is safe to seed
# fictional schools. Set to "false" once real schools are onboarded —
# see DEPLOYMENT.md.
DEMO_MODE=true
